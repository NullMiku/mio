yobu "kiso/array";
yobu "kiso/string";
kata P { x: int64; name: string; }
waza fib(n: int64) -> int64 { moshi (n < 2) { kaesu n; } kaesu fib(n - 1) + fib(n - 2); }
kaku ps: []P = [];
kaku i = 0;
aida (i < 5) { array.push(ps, P { x: fib(i + 10), name: string.concat("p", "q") }); i = i + 1; }
kaku total = 0; kaku j = 0;
aida (j < len(ps)) { total = total + ps[j].x; j = j + 1; }
chant(total); chant(ps[4].name);
