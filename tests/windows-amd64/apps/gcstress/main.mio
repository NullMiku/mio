yobu "kiso/array";
kata Cell { value: int64; next: Cell?; }
waza chain(n: int64) -> Cell? {
    kaku head: Cell? = mu; kaku i = 0;
    aida (i < n) { head = Cell { value: i, next: head }; i = i + 1; }
    kaesu head;
}
waza sum(c: Cell?) -> int64 { moshi (c == mu) { kaesu 0; } kaesu c.value + sum(c.next); }
kaku keep = chain(900);
kaku acc = 0; kaku i = 0;
aida (i < 30000) {
    kaku junk = array.make[int64](2000, i);
    acc = acc + junk[1999] + sum(chain(50));
    i = i + 1;
}
chant(acc); chant(sum(keep));
