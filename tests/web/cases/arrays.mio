yobu "kiso/array";
kaku xs = [3, 1, 4, 1, 5, 9, 2, 6];
chant(len(xs)); chant(xs[0]); chant(xs[7]);
xs[1] = 10; chant(xs[1]);
kaku total = 0; kaku i = 0;
aida (i < len(xs)) { total = total + xs[i]; i = i + 1; }
chant(total);
kaku grow = array.with_capacity[string](2);
array.push(grow, "a"); array.push(grow, "b"); array.push(grow, "c");
chant(len(grow)); chant(grow[2]);
kaku copy = array.clone(xs); copy[0] = 99; chant(xs[0]); chant(copy[0]);
array.truncate(copy, 3); chant(len(copy));
kaku grid = [[1, 2], [3, 4]]; chant(grid[1][0]);
kaku filled = array.make[float64](3, 0.5); chant(filled[2]);
