yobu "kiso/math";
kaku a = 17; kaku b = 5;
chant(a + b); chant(a - b); chant(a * b); chant(a / b); chant(-a / b);
chant(9223372036854775807); chant(-9223372036854775807 - 1);
kaku x = 1.25; kaku y = 0.5;
chant(x + y); chant(x * y); chant(x / y); chant(x - 2.0);
chant(math.sqrt(2.0)); chant(math.floor(-1.5)); chant(1.0 / 3.0);
kaku s: int8 = int8(100); chant(s); kaku u: uint8 = uint8(250); chant(u);
chant(float32(0.1)); chant(int64(3.99)); chant(float64(7) / 2.0);
