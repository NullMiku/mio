kata Vec { x: float64; y: float64; }
kata Particle { name: string; position: Vec; mass: int64; }
waza moved(p: Particle, dx: float64) -> Particle {
    kaesu Particle { name: p.name, position: Vec { x: p.position.x + dx, y: p.position.y }, mass: p.mass };
}
kaku p = Particle { name: "ion", position: Vec { x: 1.0, y: 2.0 }, mass: 7 };
kaku q = moved(p, 0.5);
chant(q.name); chant(q.position.x); chant(p.position.x); chant(q.mass);
kaku ps = [p, q]; chant(ps[1].position.y);
