kata Tree { value: int64; left: Tree?; right: Tree?; }
waza sum(t: Tree?) -> int64 { moshi (t == mu) { kaesu 0; } kaesu t.value + sum(t.left) + sum(t.right); }
waza find(xs: []int64, target: int64) -> int64? {
    kaku i = 0; aida (i < len(xs)) { moshi (xs[i] == target) { kaesu i; } i = i + 1; }
    kaesu mu;
}
kaku t = Tree { value: 1, left: Tree { value: 2, left: mu, right: mu }, right: Tree { value: 3, left: mu, right: mu } };
chant(sum(t)); chant(sum(mu));
kaku at = find([5, 6, 7], 7); moshi (at != mu) { chant(at); }
chant(find([5, 6, 7], 8) == mu);
kaku label: string? = mu; chant(label == mu); label = "set"; moshi (label != mu) { chant(label); }
