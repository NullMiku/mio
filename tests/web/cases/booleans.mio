waza classify(n: int64) -> string {
    moshi (n < 0) { kaesu "negative"; } sore { moshi (n == 0) { kaesu "zero"; } }
    kaesu "positive";
}
chant(hai); chant(iie); chant(!hai); chant(hai && iie); chant(hai || iie);
chant(3 < 4 && 4 <= 4); chant(5 > 6 || 6 >= 6);
chant(classify(-3)); chant(classify(0)); chant(classify(8));
kaku i = 0; kaku evens = 0;
aida (i < 10) { moshi ((i / 2) * 2 == i) { evens = evens + 1; } i = i + 1; }
chant(evens);
