sentaku Token { Number(int64); Plus; Times; Word(string); }
waza describe(t: Token) -> string {
    awase (t) {
        baai Number(n) { moshi (n > 9) { kaesu "big number"; } kaesu "number"; }
        baai Plus { kaesu "plus"; }
        baai Times { kaesu "times"; }
        baai Word(w) { kaesu w; }
    }
    kaesu "?";
}
kaku tokens = [Token.Number(3), Token.Plus(), Token.Number(42), Token.Times(), Token.Word("ことば")];
kaku i = 0; aida (i < len(tokens)) { chant(describe(tokens[i])); i = i + 1; }
