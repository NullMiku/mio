yobu "kiso/string";
yobu "kiso/utf8";
kaku greeting = "こんにちは、Mio 🍡";
chant(greeting);
chant(string.byte_len(greeting)); chant(string.rune_count(greeting));
chant(string.contains(greeting, "Mio")); chant(string.index(greeting, "Mio"));
chant(string.has_prefix(greeting, "こん")); chant(string.has_suffix(greeting, "🍡"));
chant(string.concat("über", "straße"));
chant(string.trim_space("  空白  "));
kaku b = string.new_builder();
string.write_string(b, "α"); string.write_rune(b, 'β'); string.write_rune(b, '😀');
chant(string.builder_string(b)); chant(string.builder_len(b));
kaku bytes = string.to_bytes("é"); chant(len(bytes)); chant(bytes[0]); chant(bytes[1]);
chant(utf8.valid(bytes)); chant("tab\tquote\"backslash\\");
