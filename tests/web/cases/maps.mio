kaku stock = Map[string, int64]();
stock["りんご"] = 3; stock["mochi"] = 12; stock["りんご"] = 4;
kaku apples = stock["りんご"]; moshi (apples != mu) { chant(apples); }
kaku m = stock["mochi"]; moshi (m != mu) { chant(m); }
chant(stock["missing"] == mu);
kaku squares = Map[int64, int64]();
kaku i = 0; aida (i < 100) { squares[i] = i * i; i = i + 1; }
kaku s = squares[99]; moshi (s != mu) { chant(s); }
