waza fib(n: int64) -> int64 { moshi (n < 2) { kaesu n; } kaesu fib(n - 1) + fib(n - 2); }
waza ack(m: int64, n: int64) -> int64 {
    moshi (m == 0) { kaesu n + 1; }
    moshi (n == 0) { kaesu ack(m - 1, 1); }
    kaesu ack(m - 1, ack(m, n - 1));
}
waza is_even(n: int64) -> bool { moshi (n == 0) { kaesu hai; } kaesu is_odd(n - 1); }
waza is_odd(n: int64) -> bool { moshi (n == 0) { kaesu iie; } kaesu is_even(n - 1); }
waza greet(name: string) -> unit { chant(name); }
chant(fib(20)); chant(ack(2, 3)); chant(is_even(10)); chant(is_odd(7));
greet("関数");
