// RA-1 / cross-generation references and write barrier: long-lived (tenured on a generational target) containers
// receive references to freshly allocated objects through array element stores, map inserts and overwrites,
// array.push, captured-cell assignment and global assignment. Those young objects are reachable only from the old
// containers and must survive later (minor) collections; replaced values must not resurrect.
// (Mio has no struct field assignment, so these are all the reference store paths of the language.)
yobu "kiso/array";
kata Item { id: int64; payload: []int64; }
kata Cell { get: () -> Item; set: (Item) -> unit; }
kaku failures = 0;
waza check(ok: bool, label: string) -> unit { moshi (!ok) { failures = failures + 1; chant(label); } }
waza churn(n: int64) -> int64 { kaku t = 0; kaku i = 0; aida (i < n) { kaku j = array.make[int64](32768, i); t = t + j[2]; i = i + 1; } kaesu t; }
waza item(id: int64) -> Item { kaesu Item { id: id, payload: array.make[int64](3, id * 2) }; }
waza make_cell() -> Cell {
    kaku current = item(-1);
    kaesu Cell { get: waza () -> Item { kaesu current; }, set: waza (v: Item) -> unit { current = v; } };
}
waza verify_slot(s: Item?, id: int64) -> int64 {
    moshi (s == mu) { check(iie, "reference lost"); kaesu 0; }
    check(s.id == id && s.payload[2] == id * 2, "stored reference");
    kaesu s.id;
}
kaku latest_global = item(-1);
waza set_global(v: Item) -> unit { latest_global = v; }
// old containers: allocated first and aged through many collections
kaku slots: []Item? = []; kaku i = 0;
aida (i < 256) { array.push(slots, mu); i = i + 1; }
kaku elems: []Item = []; i = 0;
aida (i < 256) { array.push(elems, item(-1)); i = i + 1; }
kaku table = Map[int64, Item]();
kaku growing: []Item = [];
kaku cell = make_cell();
kaku age = 0; aida (age < 12) { churn(16); age = age + 1; }
// young values stored into old containers, each followed by allocation pressure
kaku setter = cell.set;
kaku round = 0;
aida (round < 2048) {
    kaku k = round - (round / 256) * 256;
    slots[k] = item(round);               // nullable element store into an old array
    elems[k] = item(round + 100000);      // element store into an old array
    table[k] = item(round + 200000);      // map insert / overwrite in an old map
    moshi (round < 512) { array.push(growing, item(round + 300000)); }  // push into an old array
    setter(item(round + 400000));         // captured cell assignment
    set_global(item(round + 500000));     // global assignment
    moshi (round - (round / 64) * 64 == 63) { churn(2); }
    round = round + 1;
}
churn(32);
kaku sum = 0; i = 0;
aida (i < 256) {
    sum = sum + verify_slot(slots[i], 1792 + i);
    check(elems[i].id == 101792 + i && elems[i].payload[0] == elems[i].id * 2, "element store");
    verify_slot(table[i], 201792 + i);
    i = i + 1;
}
check(len(growing) == 512 && growing[511].id == 300511 && growing[0].payload[0] == 600000, "push");
kaku getter = cell.get; kaku latest = getter();
check(latest.id == 402047 && latest.payload[2] == 804094, "captured cell");
check(latest_global.id == 502047 && latest_global.payload[1] == 1004094, "global");
chant(sum);
check(sum == 256 * 1792 + 32640, "slot ids");
moshi (failures == 0) { chant("cross_generation: ok"); } sore { chant("cross_generation: FAIL"); chant(failures); }
