// Runtime ABI contract RA-1 / object layout: every size class and field kind keeps its exact contents across
// collections. Objects of neighbouring sizes must not overlap (header, alignment and size rounding are correct),
// and scalar payloads that look like heap addresses are never treated as references (precise pointer layout).
yobu "kiso/array";
kata Mixed { a: int64; s: string; f: float64; n: int64?; b: bool; xs: []int64; u: uint8; next: Mixed?; }
kata Tiny { v: uint8; }
kaku failures = 0;
waza check(ok: bool, label: string) -> unit { moshi (!ok) { failures = failures + 1; chant(label); } }
waza mod(a: int64, b: int64) -> int64 { kaesu a - (a / b) * b; }
waza mixed(i: int64, next: Mixed?) -> Mixed {
    kaku n: int64? = mu; moshi (mod(i, 3) != 0) { n = i * 4294967296; }
    kaesu Mixed { a: i * 65536 * 16, s: "m", f: float64(i) * 0.5, n: n, b: mod(i, 2) == 0,
        xs: array.make[int64](mod(i, 9) + 1, i * 16), u: uint8(mod(i, 251)), next: next };
}
// arrays of every element width with lengths 0..47 (all small size classes)
kaku bytes: [][]uint8 = []; kaku words: [][]int32 = []; kaku longs: [][]int64 = []; kaku reals: [][]float64 = [];
kaku texts: [][]string = []; kaku tinies: [][]Tiny = [];
kaku len_at = 0;
aida (len_at < 48) {
    array.push(bytes, array.make[uint8](len_at, uint8(mod(len_at, 256))));
    array.push(words, array.make[int32](len_at, int32(len_at * 1000)));
    array.push(longs, array.make[int64](len_at, len_at * 4096 + 16));
    array.push(reals, array.make[float64](len_at, float64(len_at) + 0.25));
    array.push(texts, array.make[string](len_at, "t"));
    array.push(tinies, array.make[Tiny](len_at, Tiny { v: uint8(len_at) }));
    len_at = len_at + 1;
}
kaku chain: Mixed? = mu; kaku i = 0;
aida (i < 600) { chain = mixed(i, chain); i = i + 1; }
// churn: about 96 MiB in large blocks and 20000 small objects, so that every target collects several times
kaku round = 0; kaku sink = 0;
aida (round < 192) {
    kaku junk = array.make[int64](65536, round); sink = sink + junk[65535];
    kaku k = 0; aida (k < 100) { kaku t = mixed(k, mu); sink = sink + int64(t.u); k = k + 1; }
    round = round + 1;
}
len_at = 0;
aida (len_at < 48) {
    check(len(bytes[len_at]) == len_at && len(words[len_at]) == len_at && len(longs[len_at]) == len_at, "length");
    kaku j = 0;
    aida (j < len_at) {
        check(bytes[len_at][j] == uint8(mod(len_at, 256)), "uint8 element");
        check(words[len_at][j] == int32(len_at * 1000), "int32 element");
        check(longs[len_at][j] == len_at * 4096 + 16, "int64 element");
        check(reals[len_at][j] == float64(len_at) + 0.25, "float64 element");
        check(texts[len_at][j] == "t", "string element");
        check(tinies[len_at][j].v == uint8(len_at), "struct element");
        j = j + 1;
    }
    len_at = len_at + 1;
}
waza verify(cur: Mixed?, expect: int64) -> Mixed? {
    moshi (cur == mu) { check(iie, "chain too short"); kaesu mu; }
    check(cur.a == expect * 65536 * 16, "int64 field");
    check(cur.s == "m", "string field");
    check(cur.f == float64(expect) * 0.5, "float64 field");
    check(cur.b == (mod(expect, 2) == 0), "bool field");
    check(len(cur.xs) == mod(expect, 9) + 1 && cur.xs[0] == expect * 16, "array field");
    check(cur.u == uint8(mod(expect, 251)), "uint8 field");
    verify_nullable(cur.n, expect);
    kaesu cur.next;
}
waza verify_nullable(n: int64?, expect: int64) -> unit {
    moshi (mod(expect, 3) == 0) { check(n == mu, "nil field"); kaesu; }
    moshi (n == mu) { check(iie, "nullable field lost"); kaesu; }
    check(n == expect * 4294967296, "nullable field");
}
kaku count = 0; kaku cursor = chain; kaku expect = 599;
aida (expect >= 0) { cursor = verify(cursor, expect); count = count + 1; expect = expect - 1; }
check(cursor == mu, "chain too long");
chant(count); chant(sink);
moshi (failures == 0) { chant("object_layout: ok"); } sore { chant("object_layout: FAIL"); chant(failures); }
