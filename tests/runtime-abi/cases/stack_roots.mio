// RA-1 / stack roots, nested calls and recursion: references held only by locals and parameters of active frames
// (at any depth, including recursive frames) survive collections triggered deeper in the call chain.
yobu "kiso/array";
kata Node { id: int64; label: string; kids: []Node; }
kaku failures = 0;
waza check(ok: bool, label: string) -> unit { moshi (!ok) { failures = failures + 1; chant(label); } }
waza churn(n: int64) -> int64 {
    kaku total = 0; kaku i = 0;
    aida (i < n) { kaku junk = array.make[int64](32768, i); total = total + junk[32767]; i = i + 1; }
    kaesu total;
}
waza leaf(id: int64) -> Node { kaesu Node { id: id, label: "leaf", kids: [] }; }
// five nested frames, each holding its own reference while the innermost one churns
waza level5(a: Node) -> int64 { kaku mine = leaf(5); kaesu churn(24) + a.id + mine.id; }
waza level4(a: Node) -> int64 { kaku mine = leaf(4); kaku r = level5(mine); check(a.id == 3 && mine.id == 4, "level4"); kaesu r + a.id; }
waza level3(a: Node) -> int64 { kaku mine = leaf(3); kaku r = level4(mine); check(a.id == 2 && mine.label == "leaf", "level3"); kaesu r + a.id; }
waza level2(a: Node) -> int64 { kaku mine = leaf(2); kaku r = level3(mine); check(a.id == 1, "level2"); kaesu r + a.id; }
waza level1() -> int64 { kaku mine = leaf(1); kaku r = level2(mine); check(mine.id == 1, "level1"); kaesu r; }
// recursion: every frame owns a node; the deepest frame triggers collections
waza build(depth: int64) -> Node {
    kaku here = Node { id: depth, label: "tree", kids: [] };
    moshi (depth == 0) { churn(16); kaesu here; }
    kaku left = build(depth - 1);
    kaku right = leaf(depth * 100);
    array.push(here.kids, left); array.push(here.kids, right);
    kaesu here;
}
waza walk(n: Node) -> int64 {
    kaku total = n.id; kaku i = 0;
    aida (i < len(n.kids)) { total = total + walk(n.kids[i]); i = i + 1; }
    kaesu total;
}
waza deep(depth: int64, keep: []int64) -> int64 {
    kaku mine = array.make[int64](4, depth);
    moshi (depth == 0) { kaesu churn(8) + keep[0]; }
    kaku below = deep(depth - 1, mine);
    check(mine[3] == depth && keep[0] == depth + 1, "deep frame");
    kaesu below + mine[0];
}
chant(level1());
kaku tree = build(300); churn(16);
chant(walk(tree));
chant(deep(900, [901]));
moshi (failures == 0) { chant("stack_roots: ok"); } sore { chant("stack_roots: FAIL"); chant(failures); }
