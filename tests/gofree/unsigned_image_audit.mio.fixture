yobu "kiso/fs";
yobu "kiso/os";
yobu "kiso/array";
yobu "kiso/bytes";
yobu "kiso/string";
yobu "kiso/convert";
yobu "kiso/crypto/sha256";
yobu "kiso/aot/sign";
waza read32(data: []uint8, at: int64) -> int64 { kaesu int64(data[at])+int64(data[at+1])*256+int64(data[at+2])*65536+int64(data[at+3])*16777216; }
waza write32(data: []uint8, at: int64, value: int64) -> unit { kaku left=value;kaku i=0;aida(i<4){data[at+i]=uint8(left-(left/256)*256);left=left/256;i=i+1;} }
waza hex(data: []uint8) -> string {kaku digits=string.to_bytes("0123456789abcdef");kaku output: []uint8=[];kaku i=0;aida(i<len(data)){kaku value=int64(data[i]);array.push(output,digits[value/16]);array.push(output,digits[value-(value/16)*16]);i=i+1;}kaku text=string.from_utf8(output);moshi(text==mu){kaesu "";}kaesu text;}
waza fail(message: string) -> unit {fs.write_all("/dev/stderr",string.to_bytes(string.concat(message,"\n")));os.exit(1);}
waza run() -> unit {
 kaku args=os.arguments();moshi(len(args)!=4){fail("usage: signed unsigned metadata");kaesu;}
 kaku loaded=fs.read_all(args[1]);kaku image=loaded.data;moshi(loaded.error!=mu || len(image)<768){fail("read signed image");kaesu;}
 moshi(read32(image,0)!=4277009103 || read32(image,4)!=16777228){fail("ARM64 Mach-O required");kaesu;}
 kaku count=read32(image,16);kaku command_bytes=read32(image,20);moshi(count<2 || count>32 || command_bytes>736){fail("load command bounds");kaesu;}
 kaku at=32;kaku index=0;kaku linkedit=-1;kaku signature=-1;
 aida(index<count){moshi(at+8>32+command_bytes){fail("load command truncation");kaesu;}kaku cmd=read32(image,at);kaku size=read32(image,at+4);moshi(size<8 || at+size>32+command_bytes){fail("load command size");kaesu;}
  moshi(cmd==25 && size>=72){kaku name: []uint8=[95,95,76,73,78,75,69,68,73,84,0,0,0,0,0,0];kaku equal=hai;kaku n=0;aida(n<16){moshi(image[at+8+n]!=name[n]){equal=iie;}n=n+1;}moshi(equal){linkedit=at;}}
  moshi(cmd==29){moshi(signature!=-1 || size!=16 || index!=count-1){fail("signature is not unique final command");kaesu;}signature=at;}
  at=at+size;index=index+1;
 }
 moshi(at!=32+command_bytes || signature<0 || linkedit<0){fail("missing canonical signature layout");kaesu;}
 kaku limit=read32(image,signature+8);kaku length=read32(image,signature+12);moshi(limit<768 || limit+length!=len(image) || read32(image,linkedit+40)!=limit || read32(image,linkedit+44)!=0){fail("signature length/layout");kaesu;}
 kaku original=array.with_capacity[uint8](limit);at=0;aida(at<limit){array.push(original,image[at]);at=at+1;}
 write32(original,16,count-1);write32(original,20,command_bytes-16);at=0;aida(at<16){original[signature+at]=uint8(0);at=at+1;}
 // macho.executable's canonical unsigned LINKEDIT reserves one16384-byte VM page.
 write32(original,linkedit+32,16384);write32(original,linkedit+36,0);write32(original,linkedit+48,0);write32(original,linkedit+52,0);
 kaku signed=sign.adhoc(original);moshi(signed.error!="" || !bytes.equal(signed.bytes,image)){fail("lossless native signing roundtrip mismatch");kaesu;}
 moshi(fs.write_all(args[2],original).error!=mu){fail("write complete unsigned image");kaesu;}
 kaku output=string.new_builder();string.write_string(output,"{\"status\":\"PASS\",\"full_signing_roundtrip\":true,\"signed_sha256\":\"");string.write_string(output,hex(sha256.sum(image)));string.write_string(output,"\",\"unsigned_sha256\":\"");string.write_string(output,hex(sha256.sum(original)));string.write_string(output,"\",\"unsigned_bytes\":");string.write_string(output,convert.format_int(len(original)));string.write_string(output,"}\n");
 moshi(fs.write_all(args[3],string.to_bytes(string.builder_string(output))).error!=mu){fail("write native hash record");}
}run();
