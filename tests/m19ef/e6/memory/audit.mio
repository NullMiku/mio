// Native M19c policy component regression. Actual unchanged production emitter;
// controlled policy inputs and one explicitly substituted counter read. This
// checks policy/ABI, not actual GC concurrency, OS pressure or pause durations.
yobu "kiso/fs";yobu "kiso/os";yobu "kiso/aot/sign";
kaku policy_checks=0;kaku policy_tick=1000000;
waza policy_set(c:arm64.Assembler,slot:int64,value:int64) -> unit {move_bits(c,10,uint32(0),uint32(value));emit(c,arm64.str_x(10,23,slot));}
waza policy_eq(c:arm64.Assembler,reg:int64,value:int64) -> unit {
 policy_checks=policy_checks+1;emit(c,arm64.movz_x(28,policy_checks,0));move_bits(c,11,uint32(0),uint32(value));emit(c,arm64.cmp_x(reg,11));arm64.assembler_b_cond(c,1,"policy_fail");
}
waza policy_metric(c:arm64.Assembler,slot:int64,value:int64) -> unit {emit(c,arm64.ldr_x(10,23,slot));policy_eq(c,10,value);}
waza policy_sample(c:arm64.Assembler,used:int64,fresh:bool,before:int64,reclaimed:int64) -> unit {
 policy_tick=policy_tick+20000;policy_set(c,3072,policy_tick);kaku previous=policy_tick;moshi(fresh){previous=previous-20000;}policy_set(c,2680,previous);
 move_x(c,0,23);move_bits(c,1,uint32(0),uint32(used));emit(c,arm64.movz_x(2,0,0));move_bits(c,3,uint32(0),uint32(1000000));move_bits(c,4,uint32(0),uint32(1000000));move_bits(c,5,uint32(0),uint32(before));move_bits(c,6,uint32(0),uint32(reclaimed));arm64.assembler_bl(c,"memory.update");
}
waza main() -> unit {
 kaku args=os.arguments();moshi(len(args)!=2){os.exit(64);kaesu;}
 kaku c=arm64.assembler();emit(c,arm64.sub_imm_x(31,31,1,hai));emit(c,arm64.add_imm_x(23,31,0,iie));
 kaku at=0;aida(at<4096){emit(c,arm64.str_x(31,23,at));at=at+8;}
 policy_set(c,2712,1000000);policy_set(c,2608,3065536);policy_set(c,2752,2);policy_set(c,2672,1);
 kaku used=[0,700000,850000,950000];at=0;aida(at<len(used)){policy_sample(c,used[at],iie,0,0);policy_metric(c,2640,at);moshi(at>0){policy_metric(c,2648,1);}at=at+1;}
 policy_sample(c,0,iie,0,0);policy_metric(c,2640,3);
 at=0;aida(at<3){policy_sample(c,0,hai,0,0);kaku expected=3;moshi(at==2){expected=0;}policy_metric(c,2640,expected);at=at+1;}
 policy_set(c,2616,2800000);policy_sample(c,0,iie,0,0);policy_metric(c,2640,2);policy_metric(c,2648,2);
 policy_set(c,2616,0);policy_set(c,2640,0);policy_set(c,2632,10000000);policy_sample(c,0,iie,0,0);policy_metric(c,2640,3);policy_metric(c,2648,4);
 policy_set(c,2632,0);policy_set(c,2640,0);policy_sample(c,600000,iie,900000,1);policy_metric(c,2640,1);policy_metric(c,2648,8);
 policy_set(c,2640,0);policy_set(c,2672,4);policy_sample(c,0,iie,0,0);policy_metric(c,2640,3);policy_metric(c,2648,16);
 policy_set(c,2664,1);move_x(c,0,23);emit(c,arm64.add_imm_x(1,23,3136,iie));arm64.assembler_bl(c,"memory.snapshot");
 policy_metric(c,3136,3);policy_metric(c,3144,16);policy_metric(c,3184,1);emit(c,arm64.ldr_x(10,23,3192));emit(c,arm64.lsr_x(11,10,1));emit(c,arm64.lsl_x(11,11,1));emit(c,arm64.cmp_x(10,11));arm64.assembler_b_cond(c,1,"policy_fail");
 policy_set(c,2640,0);policy_set(c,2752,0);policy_sample(c,0,iie,0,0);policy_metric(c,2640,0);policy_metric(c,2648,0);policy_metric(c,2752,0);
 move_x(c,0,23);move_bits(c,1,uint32(0),uint32(400000));move_bits(c,2,uint32(0),uint32(500000));arm64.assembler_bl(c,"memory.goal");policy_metric(c,2600,1000000);
 policy_set(c,2712,8388608);move_x(c,0,23);move_bits(c,1,uint32(0),uint32(2097152));move_bits(c,2,uint32(0),uint32(1048576));arm64.assembler_bl(c,"memory.goal");policy_metric(c,2600,5242880);
 move_x(c,0,23);emit(c,arm64.movz_x(1,0,0));emit(c,arm64.movz_x(2,0,0));arm64.assembler_bl(c,"memory.goal");policy_metric(c,2600,1048576);
 emit(c,arm64.str_x(28,23,3200));emit(c,arm64.movz_x(0,1,0));emit(c,arm64.add_imm_x(1,23,3200,iie));emit(c,arm64.movz_x(2,8,0));emit(c,arm64.movz_x(16,4,0));emit(c,arm64.svc(128));emit(c,arm64.movz_x(0,0,0));emit(c,arm64.movz_x(16,1,0));emit(c,arm64.svc(128));
 arm64.assembler_label(c,"policy_fail");emit(c,arm64.str_x(28,23,3200));emit(c,arm64.movz_x(0,2,0));emit(c,arm64.add_imm_x(1,23,3200,iie));emit(c,arm64.movz_x(2,8,0));emit(c,arm64.movz_x(16,4,0));emit(c,arm64.svc(128));emit(c,arm64.movz_x(0,1,0));emit(c,arm64.movz_x(16,1,0));emit(c,arm64.svc(128));
 emit_memory_policy(c);
 kaku clock=arm64.assembler_label_word(c,"memory.initialized");moshi(clock<0 || c.words[clock]!=uint32(3577471064)){os.exit(65);kaesu;}
 // 3072 lies OUTSIDE the production metadata, in this probe's private stack.
 c.words[clock]=arm64.ldr_x(24,19,3072).word;
 kaku assembled=arm64.assembler_assemble(c);moshi(assembled.error!=mu){os.exit(66);kaesu;}
 kaku image=macho.executable(macho.ImageSpec {words:assembled.words,constants:[],globals:0,patches:[]});moshi(image.error!=mu){os.exit(67);kaesu;}
 kaku signed=sign.adhoc(image.bytes);moshi(signed.error!=""){os.exit(68);kaesu;}
 moshi(fs.write_all(args[1],signed.bytes).error!=mu || os.chmod(args[1],493)!=0){os.exit(69);kaesu;}
 chant(policy_checks);
}
main();
