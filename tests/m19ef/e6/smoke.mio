yobu "kiso/array";
kata Node {value:int64;next:Node?;}
kaku values:[]int64=[];array.reserve(values,2048);kaku i=0;
aida(i<2048){array.push(values,i);i=i+1;}
kaku total=0;i=0;aida(i<len(values)){total=total+values[i];i=i+1;}
chant(total);
kaku node:Node?=mu;i=0;aida(i<1000){node=Node {value:i,next:node};i=i+1;}
kaku sum=0;aida(node!=mu){sum=sum+node.value;node=node.next;}
chant(sum);chant(3.25);
