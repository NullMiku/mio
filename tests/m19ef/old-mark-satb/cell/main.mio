// Dedicated ordinary-code coverage for opcode23 captured local and opcode48.
waza rt_start(callback:() -> unit) -> int64 {kaesu 0;}
waza rt_join(handle:int64) -> int64 {kaesu 0;}
waza rt_wait(ns:int64) -> int64 {kaesu 0;}
waza rt_collect(operation:int64) -> int64 {kaesu 0;}
kata Node {value:int64;}
kaku control=0;kaku ready=0;kaku done=0;kaku failures=0;
waza dead_witness() -> unit {
 kaku dead=Node {value:99999};kaku i=0;aida(i<8){kaku occupied=rt_collect(0);i=i+1;}
 moshi(dead.value!=99999){failures=4;}
}
waza run() -> unit {
 kaku keep:Node?=Node {value:111};kaku other:Node?=Node {value:222};kaku third=Node {value:333};
 kaku callback=waza() -> unit {
  ready=1;aida(control==0){kaku waited=rt_wait(1000000);}
  kaku before=keep;kaku next=other;
  moshi(before==mu){failures=1;done=1;kaesu;}moshi(next==mu){failures=1;done=1;kaesu;}
  moshi(before.value!=111 || next.value!=222){failures=2;}
  keep=other;other=mu;keep=mu;done=1;
 };
 kaku child=rt_start(callback);aida(ready==0){kaku waited=rt_wait(1000000);}
 dead_witness();kaku started=rt_collect(2);control=1;
 aida(done==0){kaku waited=rt_wait(1000000);}
 kaku joined=rt_join(child);keep=third;keep=mu;
 kaku calls=rt_collect(8);kaku nonnull=rt_collect(9);kaku marked=rt_collect(3);
 chant(failures+started+joined);chant(calls);chant(nonnull);chant(marked);chant(rt_collect(6));chant(rt_collect(4));
}
run();chant(rt_collect(1));
