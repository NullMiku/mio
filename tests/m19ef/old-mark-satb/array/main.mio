yobu "kiso/array";
waza rt_start(callback:() -> unit) -> int64 {kaesu 0;}
waza rt_join(handle:int64) -> int64 {kaesu 0;}
waza rt_wait(ns:int64) -> int64 {kaesu 0;}
waza rt_collect(operation:int64) -> int64 {kaesu 0;}
kata Node {value:int64;}
kata Holder {pointers:[]Node?;numbers:[]int64;fillers:[]Node?;dense:[][]Node?;black:[]Node?;}
kaku shared:Holder?=mu;kaku epoch_number=0;kaku control=0;kaku done_a=0;kaku done_b=0;kaku failures=0;kaku ready_a=0;kaku ready_b=0;
waza edit(id:int64) -> unit {
 moshi(id==0){ready_a=1;}sore{ready_b=1;}
 // Ordinary automatic safepoints keep a ready Mutator parked for Init.
 aida(control==0){kaku value=control+1;}
 kaku g=shared;moshi(g==mu){failures=1;kaesu;}
 // Exact FIFO starts OwnerDesc,denseDesc0..3,Holder,closures0..1,
 // then OwnerStorage. Completion9 Release guarantees the four nil owner slots
 // have REALLY been scanned before these writes; dense LOS scans follow it.
 aida(rt_collect(7)<9 && rt_collect(4)==2){kaku observed=rt_collect(5);}
 moshi(rt_collect(4)!=2 || rt_collect(7)<9){failures=6;kaesu;}
 kaku i=5999-id;
 aida(i>=0){kaku n=g.pointers[i];moshi(n==mu){failures=2;kaesu;}
  moshi(n.value!=i){failures=3;kaesu;}
  // Create a real black-owner→still-white edge, then delete it before
  // the delayed original parent can be traced. SATB MUST publish this old
  // value here. Deleting the original parent edge afterwards sees it colored.
  moshi(i==5999-id){g.black[id]=n;}sore{g.black[id+2]=n;g.black[id+2]=mu;}
  g.pointers[i]=mu;g.numbers[i]=i+1;moshi(g.numbers[i]!=i+1){failures=7;kaesu;}kaku overlap=rt_collect(5);i=i-2;
 }
 moshi(id==0){done_a=1;}sore{done_b=1;}
}
waza first() -> unit {edit(0);}
waza second() -> unit {edit(1);}
waza prepare() -> unit {
 kaku g=Holder {pointers:array.with_capacity[Node?](6000),numbers:array.with_capacity[int64](6000),fillers:array.with_capacity[Node?](6000),dense:array.with_capacity[[]Node?](4),black:array.make[Node?](4,mu)};
 kaku i=0;aida(i<6000){array.push(g.pointers,Node {value:i});array.push(g.numbers,i);array.push(g.fillers,Node {value:i+10000});i=i+1;}
 i=0;aida(i<4){array.push(g.dense,array.make[Node?](200000,g.fillers[0]));i=i+1;}shared=g;
}
waza dead_witness() -> unit {
 kaku dead=Node {value:99999};kaku i=0;aida(i<8){kaku occupied=rt_collect(0);i=i+1;}
 moshi(dead.value!=99999){failures=4;}
}
// A real dense Old LOS graph precedes the mutable target graph. Its four
// 200000-reference storages retain legitimate filler Nodes and require actual
// typed tracing, so early Worker edits are adversarial even on a fast marker.
// No artificial marker delay or manually published Root participates.
waza young_frontier() -> [][]Node? {
 kaku g=shared;moshi(g==mu){kaesu [];}
 kaku roots=array.with_capacity[[]Node?](5);array.push(roots,g.black);kaku i=0;
 aida(i<4){array.push(roots,g.dense[i]);i=i+1;}kaesu roots;
}
waza run() -> unit {
prepare();kaku a=rt_start(first);kaku b=rt_start(second);
aida(ready_a+ready_b<2){kaku waited=rt_wait(1000000);}
dead_witness();kaku frontier=young_frontier();kaku started=rt_collect(2);control=1;
aida(done_a+done_b<2 && failures==0){kaku waited=rt_wait(1000000);}
kaku ja=rt_join(a);kaku jb=rt_join(b);
// Delete the remaining graph root while ConcurrentMark is still active.
shared=mu;kaku calls=rt_collect(8);kaku nonnull=rt_collect(9);kaku claimed=rt_collect(10);
kaku marked=rt_collect(3);
// These highest-index Nodes remain reachable through the already-scanned
// owner and the live Young frontier. Original storage scans ascending while
// Mutators delete descending: loss of ANY snapshot target without SATB also
// leaves at least one retained high Node white, unsafe for a subsequent Sweep.
kaku retained=frontier[0];kaku high_a=retained[0];kaku high_b=retained[1];
moshi(high_a==mu){failures=8;}sore{moshi(high_a.value!=5999){failures=9;}}
moshi(high_b==mu){failures=8;}sore{moshi(high_b.value!=5998){failures=9;}}

// Keep the legitimate Young frontier through Remark, then clear for Major.
moshi(len(frontier)!=5){failures=5;}
chant(failures+started+ja+jb);chant(done_a+done_b);chant(calls);chant(nonnull);chant(claimed);chant(marked);chant(rt_collect(6));chant(rt_collect(4));chant(rt_collect(5));
}
// Fixed four complete epochs per sample, regardless of witness timing. Every
// functional result is checked; no failed run is retried or discarded.
aida(epoch_number<4){control=0;ready_a=0;ready_b=0;done_a=0;done_b=0;run();chant(rt_collect(1));epoch_number=epoch_number+1;}
