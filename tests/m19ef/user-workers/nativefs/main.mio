yobu "kiso/fs";
waza rt_start(callback:() -> unit) -> int64 {kaesu 0;}
waza rt_join(handle:int64) -> int64 {kaesu 0;}
waza rt_wait(ns:int64) -> int64 {kaesu 0;}
waza rt_collect(major:int64) -> int64 {kaesu 0;}
kaku done_a=0;kaku done_b=0;kaku failure_a=0;kaku failure_b=0;
waza worker(id:int64) -> unit {
    kaku i=0;kaku failures=0;
    aida(i<20){
        kaku file=fs.read_all("VERSION");
        moshi(file.error!=mu || len(file.data)!=6){failures=failures+1;}
        kaku absent=fs.read_all("build/does-not-exist-m19e-negative");
        moshi(absent.error==mu){failures=failures+1;}
        i=i+1;
    }
    moshi(id==1){failure_a=failures;done_a=1;}sore{failure_b=failures;done_b=1;}
}
kaku a=rt_start(waza() -> unit {worker(1);});kaku b=rt_start(waza() -> unit {worker(2);});kaku step=0;
aida(done_a+done_b<2){kaku occupied=rt_collect(step-(step/2)*2);kaku waited=rt_wait(1000000);step=step+1;}
kaku ja=rt_join(a);kaku jb=rt_join(b);
chant(failure_a+failure_b);chant(done_a+done_b);chant(ja+jb);chant(rt_collect(1));
