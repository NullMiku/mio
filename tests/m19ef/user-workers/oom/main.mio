yobu "kiso/array";
waza rt_start(callback:() -> unit) -> int64 {kaesu 0;}
waza rt_join(handle:int64) -> int64 {kaesu 0;}
waza rt_wait(ns:int64) -> int64 {kaesu 0;}
waza rt_collect(major:int64) -> int64 {kaesu 0;}
waza worker() -> unit {kaku large=array.make[uint8](2097152,uint8(17));chant(large[0]);}
kaku one=rt_start(worker);
moshi(one<0){kaku a=rt_join(one);kaku b=rt_wait(0);kaku c=rt_collect(0);}
