yobu "kiso/array";
waza rt_start(callback:() -> unit) -> int64 {kaesu 0;}
waza rt_join(handle:int64) -> int64 {kaesu 0;}
waza rt_wait(ns:int64) -> int64 {kaesu 0;}
waza rt_collect(major:int64) -> int64 {kaesu 0;}
waza worker() -> unit {aida(hai){kaku waited=rt_wait(1000000);}}
kaku one=rt_start(worker);kaku two=rt_start(worker);kaku third=rt_start(worker);
moshi(third<0){kaku a=rt_join(one);kaku c=rt_collect(0);}
