yobu "kiso/array";
waza rt_start(callback:() -> unit) -> int64 {kaesu 0;}
waza rt_join(handle:int64) -> int64 {kaesu 0;}
waza rt_wait(ns:int64) -> int64 {kaesu 0;}
waza rt_collect(major:int64) -> int64 {kaesu 0;}
kata Node {value:int64;}
kata Holder {a:[]Node;b:[]Node;}
kaku shared:Holder?=mu;kaku done_a=0;kaku done_b=0;
waza append_one(items:[]Node,value:int64) -> unit {array.push(items,Node {value:value});}
waza fill(items:[]Node,base:int64) -> unit {kaku i=0;aida(i<32){append_one(items,base+i);i=i+1;}}
waza first() -> unit {kaku g=shared;moshi(g==mu){kaesu;}fill(g.a,0);done_a=1;}
waza second() -> unit {kaku g=shared;moshi(g==mu){kaesu;}fill(g.b,100);done_b=1;}
waza run() -> int64 {
    kaku g=Holder {a:array.with_capacity[Node](64),b:array.with_capacity[Node](64)};shared=g;
    kaku i=0;aida(i<10){kaku occupied=rt_collect(0);i=i+1;}
    kaku a=rt_start(first);kaku b=rt_start(second);
    aida(done_a+done_b<2){kaku occupied=rt_collect(0);kaku waited=rt_wait(1000000);}
    kaku ja=rt_join(a);kaku jb=rt_join(b);kaku occupied=rt_collect(0);
    kaku failures=ja+jb;moshi(len(g.a)!=32 || len(g.b)!=32){failures=failures+1;}
    i=0;aida(i<32){moshi(g.a[i].value!=i || g.b[i].value!=i+100){failures=failures+1;}i=i+1;}
    shared=mu;kaesu failures;
}
chant(run());chant(rt_collect(1));
