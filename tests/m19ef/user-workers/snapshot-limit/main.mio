waza rt_start(callback:() -> unit) -> int64 {kaesu 0;}
waza rt_join(handle:int64) -> int64 {kaesu 0;}
waza rt_wait(ns:int64) -> int64 {kaesu 0;}
waza rt_collect(major:int64) -> int64 {kaesu 0;}
kata Node {value:int64;}
waza deep(n:int64,a:Node,b:Node,c:Node,d:Node,e:Node,f:Node,g:Node,h:Node,i:Node,j:Node) -> int64 {
    moshi(n==0){kaku occupied=rt_collect(1);kaesu a.value;}
    kaesu deep(n-1,a,b,c,d,e,f,g,h,i,j)+j.value;
}
waza work() -> unit {kaku node=Node {value:1};chant(deep(110,node,node,node,node,node,node,node,node,node,node));}
kaku child=rt_start(work);kaku joined=rt_join(child);chant(999);
