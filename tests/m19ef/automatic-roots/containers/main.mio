yobu "kiso/array";
kata Box<T> {value:T;}
waza run() -> int64 {
    kaku mapping=Map[int64,Box<int64>]();
    kaku large=array.make[uint8](131072,uint8(17));
    kaku i=0;
    aida(i<40){mapping[i]=Box[int64] {value:i+100};i=i+1;}
    kaku total=0;i=0;
    aida(i<40){kaku found=mapping[i];moshi(found!=mu){total=total+found.value;}i=i+1;}
    kaesu total+int64(large[131071]);
}
chant(run());
