// Queue + exact scanner component witness, NOT a SATB/concurrent-GC PASS.
// Two real producers hand actual promoted Old nodes to an independent native
// consumer. Production GC owns/pins the graph throughout the component test.
waza n(f:ir.Function,r:int64,v:int64) -> unit {ir.put(f,ir.constant,r,0,0,v);}
waza eq(f:ir.Function,r:int64,v:int64) -> unit {n(f,30,v);ir.put(f,ir.equal,30,r,30,0);ir.branch(f,ir.zero,30,"fail");}
waza field(f:ir.Function,base:int64,off:int64,value:int64) -> unit {n(f,29,value);ir.put(f,ir.store,0,base,29,off);}
waza fail_tail(f:ir.Function) -> unit {ir.branch(f,ir.label,0,"fail");n(f,1,87);ir.call(f,102,2,[1]);}
waza imports(f:ir.Function) -> unit {ir.put(f,ir.load,31,0,0,0);ir.put(f,ir.imports,0,31,0,0);}
waza start_clock(f:ir.Function) -> unit {
 imports(f);ir.call(f,gc.thread_identity,2,[]);ir.put(f,ir.store,0,0,2,40);ir.invoke_function(f,"platform_now",2,[]);ir.put(f,ir.store,0,0,2,24);n(f,20,10000000000);ir.put(f,ir.add,20,2,20,0);
}
waza deadline(f:ir.Function) -> unit {ir.invoke_function(f,"platform_now",6,[]);ir.put(f,ir.less_unsigned,6,6,20,0);ir.branch(f,ir.zero,6,"fail");}
waza finish(f:ir.Function) -> unit {ir.invoke_function(f,"platform_now",2,[]);ir.put(f,ir.store,0,0,2,32);n(f,2,1);ir.put(f,ir.release_store,0,0,2,56);n(f,2,0);ir.put(f,ir.result,0,2,0,0);fail_tail(f);}
waza producer() -> ir.Function {
 kaku f=ir.function("producer");start_clock(f);ir.put(f,ir.load,15,0,0,8);ir.put(f,ir.load,16,0,0,16);n(f,17,1);n(f,18,0);n(f,19,1000);
 ir.branch(f,ir.label,0,"retry");ir.invoke_function(f,"gc_work_offer",5,[15,17,16]);ir.branch(f,ir.zero,5,"published");eq_retry(f,5);deadline(f);ir.branch(f,ir.jump,0,"retry");
 ir.branch(f,ir.label,0,"published");n(f,6,1);ir.put(f,ir.add,18,18,6,0);ir.put(f,ir.store,0,0,18,48);ir.put(f,ir.less_unsigned,6,18,19,0);ir.branch(f,ir.nonzero,6,"retry");finish(f);kaesu f;
}
waza eq_retry(f:ir.Function,r:int64) -> unit {n(f,6,3);ir.put(f,ir.less_unsigned,6,r,6,0);ir.branch(f,ir.zero,6,"fail");}
waza visit() -> ir.Function {
 kaku f=ir.function("queue_visit");ir.put(f,ir.load,2,1,0,0);eq(f,2,6);ir.put(f,ir.load,2,1,0,8);ir.put(f,ir.load,3,0,0,16);ir.put(f,ir.add,3,3,2,0);ir.put(f,ir.store,0,0,3,16);ir.put(f,ir.load,3,0,0,72);n(f,2,1);ir.put(f,ir.add,3,3,2,0);ir.put(f,ir.store,0,0,3,72);n(f,2,0);ir.put(f,ir.result,0,2,0,0);fail_tail(f);kaesu f;
}
waza consumer() -> ir.Function {
 kaku f=ir.function("consumer");start_clock(f);ir.put(f,ir.load,15,0,0,8);n(f,17,1);ir.put(f,ir.address,18,0,0,64);
 ir.branch(f,ir.label,0,"take");ir.invoke_function(f,"gc_work_take",5,[15,17,18]);ir.branch(f,ir.zero,5,"item");eq_retry(f,5);ir.invoke_function(f,"gc_work_quiet",5,[15,17]);n(f,6,1);ir.put(f,ir.equal,6,5,6,0);ir.branch(f,ir.nonzero,6,"finished");eq_retry(f,5);deadline(f);ir.branch(f,ir.jump,0,"take");
 ir.branch(f,ir.label,0,"item");ir.put(f,ir.load,16,18,0,0);n(f,6,16);ir.put(f,ir.subtract,7,16,6,0);ir.put(f,ir.acquire_load,8,7,0,0);n(f,6,34359738368);ir.put(f,ir.divide_unsigned,8,8,6,0);n(f,6,2);ir.put(f,ir.divide_unsigned,7,8,6,0);ir.put(f,ir.multiply,7,7,6,0);ir.put(f,ir.subtract,8,8,7,0);eq(f,8,1);n(f,19,64);ir.invoke_function(f,"gc_trace_object",5,[0,16,19]);eq(f,5,0);
 ir.branch(f,ir.label,0,"complete");ir.invoke_function(f,"gc_work_complete",5,[15,17]);ir.branch(f,ir.zero,5,"take");eq(f,5,2);deadline(f);ir.branch(f,ir.jump,0,"complete");
 ir.branch(f,ir.label,0,"finished");finish(f);kaesu f;
}
waza allocate(f:ir.Function,size:int64,kind:int64) -> unit {
 n(f,26,size);n(f,27,kind);ir.call(f,203,22,[20,21,26,27]);ir.branch(f,ir.zero,22,"fail");ir.put(f,ir.load,28,21,0,8);n(f,29,8);ir.put(f,ir.multiply,29,28,29,0);ir.put(f,ir.add,29,21,29,0);ir.put(f,ir.store,0,29,22,16);n(f,29,1);ir.put(f,ir.add,28,28,29,0);ir.put(f,ir.store,0,21,28,8);
}
waza node(f:ir.Function,number:int64,saved:int64) -> unit {
 allocate(f,16,105);field(f,22,0,6);field(f,22,8,number);ir.put(f,ir.copy,25,22,0,0);allocate(f,56,100);field(f,22,0,1);field(f,22,8,2);field(f,22,16,2);field(f,22,24,1);field(f,22,32,1);ir.put(f,ir.store,0,22,25,40);ir.put(f,ir.store,0,22,25,48);ir.put(f,ir.copy,saved,22,0,0);
}
waza queue_call(f:ir.Function,name:string,dst:int64,args:[]int64,expected:int64) -> unit {ir.invoke_function(f,name,dst,args);eq(f,dst,expected);}
waza run() -> ir.Function {
 kaku f=ir.function("run");ir.call(f,202,20,[]);ir.branch(f,ir.zero,20,"fail");ir.put(f,ir.address,21,0,0,128);node(f,11,23);node(f,22,24);
 kaku i=0;aida(i<8){n(f,2,0);ir.call(f,201,5,[20,21,2]);eq(f,5,0);i=i+1;}
 n(f,28,16);ir.put(f,ir.subtract,29,23,28,0);ir.put(f,ir.load,5,29,0,0);n(f,28,34359738368);ir.put(f,ir.divide_unsigned,5,5,28,0);n(f,28,2);ir.put(f,ir.divide_unsigned,6,5,28,0);ir.put(f,ir.multiply,6,6,28,0);ir.put(f,ir.subtract,5,5,6,0);eq(f,5,1);
 ir.put(f,ir.address,15,0,0,512);ir.put(f,ir.address,2,0,0,640);n(f,3,2);n(f,4,16);n(f,17,1);queue_call(f,"gc_work_configure",5,[15,2,3,4,17],0);queue_call(f,"gc_work_offer",5,[15,17,23],0);queue_call(f,"gc_work_offer",5,[15,17,24],0);queue_call(f,"gc_work_offer",5,[15,17,23],1);
 // Configure all native argument blocks before any child can observe them.
 i=0;aida(i<3){ir.put(f,ir.address,10,0,0,768+i*128);ir.put(f,ir.load,11,0,0,0);ir.put(f,ir.store,0,10,11,0);ir.put(f,ir.store,0,10,15,8);moshi(i==0){ir.put(f,ir.store,0,10,23,16);}moshi(i==1){ir.put(f,ir.store,0,10,24,16);}i=i+1;}
 i=0;aida(i<3){ir.put(f,ir.address,1,0,0,256+i*8);ir.function_pointer(f,"producer",2);moshi(i==2){ir.function_pointer(f,"consumer",2);}ir.put(f,ir.address,3,0,0,768+i*128);ir.call(f,gc.thread_start,5,[1,2,3]);eq(f,5,0);i=i+1;}
 i=0;aida(i<2){ir.put(f,ir.load,1,0,0,256+i*8);n(f,2,0);ir.call(f,gc.thread_join,5,[1,2]);eq(f,5,0);i=i+1;}
 queue_call(f,"gc_work_close",5,[15,17],0);ir.put(f,ir.load,1,0,0,272);n(f,2,0);ir.call(f,gc.thread_join,5,[1,2]);eq(f,5,0);queue_call(f,"gc_work_quiet",5,[15,17],1);
 ir.put(f,ir.load,5,15,0,72);eq(f,5,2002);ir.put(f,ir.load,5,15,0,80);eq(f,5,2002);ir.put(f,ir.load,5,15,0,88);eq(f,5,2002);ir.put(f,ir.load,5,0,0,1040);eq(f,5,33033);ir.put(f,ir.load,5,0,0,1096);eq(f,5,2002);
 // Runtime trace: queue counts and overflow, sum, consumer visits, identities,
 // monotonic intervals. Addresses and headers are not read after final death.
 i=0;aida(i<4){ir.put(f,ir.load,5,15,0,72+i*8);ir.put(f,ir.store,0,0,5,280+i*8);i=i+1;}
 ir.put(f,ir.load,5,0,0,1040);ir.put(f,ir.store,0,0,5,312);ir.put(f,ir.load,5,0,0,1096);ir.put(f,ir.store,0,0,5,320);
 i=0;aida(i<3){ir.put(f,ir.load,5,0,0,808+i*128);ir.put(f,ir.store,0,0,5,328+i*8);ir.put(f,ir.load,5,0,0,792+i*128);ir.put(f,ir.store,0,0,5,352+i*16);ir.put(f,ir.load,5,0,0,800+i*128);ir.put(f,ir.store,0,0,5,360+i*16);i=i+1;}
 // The same buffer is reused only at closed+quiet; stale Epoch1 calls fail.
 ir.put(f,ir.address,2,0,0,640);n(f,3,2);n(f,4,16);n(f,18,2);queue_call(f,"gc_work_configure",5,[15,2,3,4,18],0);queue_call(f,"gc_work_offer",5,[15,17,23],4);queue_call(f,"gc_work_complete",5,[15,18],4);queue_call(f,"gc_work_offer",5,[15,18,23],0);queue_call(f,"gc_work_close",5,[15,18],0);queue_call(f,"gc_work_quiet",5,[15,18],0);ir.put(f,ir.address,19,0,0,416);queue_call(f,"gc_work_take",5,[15,18,19],0);queue_call(f,"gc_work_quiet",5,[15,18],0);queue_call(f,"gc_work_complete",5,[15,18],0);queue_call(f,"gc_work_quiet",5,[15,18],1);queue_call(f,"gc_work_take",5,[15,17,19],4);queue_call(f,"gc_work_offer",5,[15,18,23],4);
 // Bounded lock contention is observable and must not release another owner.
 field(f,15,0,1);queue_call(f,"gc_work_offer",5,[15,18,23],2);ir.put(f,ir.load,5,15,0,0);eq(f,5,1);field(f,15,0,0);
 n(f,19,0);queue_call(f,"gc_work_take",5,[15,18,19],4);n(f,19,7);queue_call(f,"gc_work_abort",5,[15,18,19],0);n(f,19,9);queue_call(f,"gc_work_abort",5,[15,18,19],0);ir.put(f,ir.load,5,15,0,64);eq(f,5,7);queue_call(f,"gc_work_quiet",5,[15,18],4);queue_call(f,"gc_work_offer",5,[15,18,23],4);
 field(f,21,8,0);n(f,2,1);ir.call(f,201,5,[20,21,2]);eq(f,5,0);ir.put(f,ir.load,5,20,0,304);eq(f,5,0);ir.put(f,ir.address,1,0,0,280);n(f,2,120);ir.call(f,103,5,[1,2]);eq(f,5,120);n(f,2,0);ir.put(f,ir.result,0,2,0,0);fail_tail(f);kaesu f;
}
waza emit(c:arm64.Assembler,x:arm64.Instruction) -> unit {arm64.assembler_emit(c,x);}
waza addr(c:arm64.Assembler,p:[]macho.AddressPatch,r:int64,off:int64) -> unit {kaku at=len(c.words);emit(c,arm64.movz_x(r,0,0));emit(c,arm64.movz_x(r,0,0));array.push(p,macho.AddressPatch {at_word:at,add_at_word:at+1,target:macho.data_target(),target_offset:off,register:r});}
waza main() -> unit {
 kaku functions=gc.work_queue_program();array.append_all(functions,gc.trace_program_with_visitor("queue_visit"));array.append_all(functions,darwin.thread_platform_program());array.push(functions,producer());array.push(functions,consumer());array.push(functions,visit());array.push(functions,run());kaku bindings=darwin.thread_bindings();kaku ops=[202,203,201];kaku args:[][]int64=[[],[0,1,2,3],[0,1,2]];kaku i=0;aida(i<3){array.push(bindings,ir.Binding {operation:ops[i],slot:21+i,arguments:args[i],result_bits:64});i=i+1;}
 kaku c=arm64.assembler();kaku patches:[]macho.AddressPatch=[];addr(c,patches,7,0);addr(c,patches,0,192);emit(c,arm64.str_x(7,0,0));kaku names=["stw_heap_init","stw_heap_alloc","stw_heap_collect"];kaku ats:[]int64=[];i=0;aida(i<3){array.push(ats,len(c.words));emit(c,arm64.movz_x(9,0,0));emit(c,arm64.str_x(9,7,(21+i)*8));i=i+1;}
 arm64.assembler_bl(c,"rt_run");emit(c,arm64.movz_x(16,1,0));emit(c,arm64.svc(128));kaku error=aarch64.emit_program(c,functions,bindings,24,"rt");moshi(error!=""){chant(error);os.exit(2);}lower.emit_stopped_heap_adapter(c,1048576);i=0;aida(i<3){kaku ins=arm64.adr(9,(arm64.assembler_label_word(c,names[i])-ats[i])*4);moshi(ins.error!=mu){os.exit(3);}c.words[ats[i]]=ins.word;i=i+1;}
 kaku assembled=arm64.assembler_assemble(c);moshi(assembled.error!=mu){os.exit(4);}kaku image=darwin.executable_appended(macho.ImageSpec {words:assembled.words,constants:[],globals:0,patches:patches},darwin.thread_symbols(),256);moshi(image.error!=""){chant(image.error);os.exit(5);}kaku signed=sign.adhoc_linked(image.bytes);moshi(signed.error!=""){os.exit(6);}kaku argv=os.arguments();fs.write_all(argv[1],signed.bytes);os.chmod(argv[1],448);
}
main();
