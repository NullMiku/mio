yobu "kiso/fs";yobu "kiso/array";
waza rt_start(callback:() -> unit) -> int64 {kaesu 0;}
waza rt_join(handle:int64) -> int64 {kaesu 0;}
waza rt_wait(ns:int64) -> int64 {kaesu 0;}
waza rt_collect(operation:int64) -> int64 {kaesu 0;}
kata Blobs {buffers:[][]uint8;}
kaku dead:Blobs?=mu;kaku phase=0;kaku read_ok=0;kaku write_ok=0;
waza reader() -> unit {
 kaku buffer=array.make[uint8](131072,uint8(90));phase=1;
 kaku opened=fs.open_read("/Users/hatsunemiku/.codex/worktrees/m19ef-portable-gc/mio/build/m19ef-sweep-reader-fifo");kaku file=opened.file;moshi(file==mu){read_ok=-1;kaesu;}
 kaku got=fs.read(file,buffer,0,1);kaku closed=fs.close(file);
 moshi(got.error==mu && got.count==1 && buffer[0]==uint8(90) && buffer[131071]==uint8(90) && closed.error==mu){read_ok=1;}sore{read_ok=-2;}
}
waza writer() -> unit {
 aida(phase<2){rt_wait(100000);}
 kaku opened=fs.open_write("/Users/hatsunemiku/.codex/worktrees/m19ef-portable-gc/mio/build/m19ef-sweep-reader-fifo");kaku file=opened.file;moshi(file==mu){write_ok=-1;kaesu;}
 kaku sent=fs.write(file,[uint8(90)],0,1);kaku closed=fs.close(file);moshi(sent.error==mu && sent.count==1 && closed.error==mu){write_ok=1;}sore{write_ok=-2;}
}
waza prepare() -> unit {
 kaku buffers:[][]uint8=[];kaku i=0;aida(i<16){array.push(buffers,array.make[uint8](131072,uint8(i)));i=i+1;}dead=Blobs {buffers:buffers};
}
// Finish all setup temporaries before the first closed Root snapshot.
waza prepare_dead() -> unit {prepare();kaku i=0;aida(i<8){rt_collect(0);i=i+1;}dead=mu;}
waza exercise() -> unit {
 kaku a=rt_start(reader);kaku b=rt_start(writer);aida(phase<1){rt_wait(100000);}
 prepare_dead();
 chant(rt_collect(2));aida(rt_collect(7)<4 && rt_collect(4)==2){rt_wait(10000);}
 chant(rt_collect(3));chant(rt_collect(30));
 chant(rt_collect(23));chant(rt_collect(35));chant(rt_collect(38));chant(rt_collect(29));chant(rt_collect(32));chant(rt_collect(33));chant(rt_collect(39));chant(rt_collect(40));
 chant(rt_collect(31));chant(rt_collect(30));chant(rt_collect(23));chant(rt_collect(35));chant(rt_collect(38));chant(rt_collect(29));chant(rt_collect(32));chant(rt_collect(33));chant(rt_collect(39));chant(rt_collect(40));
 phase=2;rt_join(a);rt_join(b);chant(read_ok);chant(write_ok);
 // Reader has actually exited; the next closed epoch can now unmap its LOS.
 chant(rt_collect(2));chant(rt_collect(3));chant(rt_collect(30));chant(rt_collect(32));chant(rt_collect(35));chant(rt_collect(38));
}
exercise();chant(rt_collect(1));
