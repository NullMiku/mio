waza rt_start(callback:() -> unit) -> int64 {kaesu 0;}
waza rt_join(handle:int64) -> int64 {kaesu 0;}
waza rt_wait(ns:int64) -> int64 {kaesu 0;}
waza rt_collect(operation:int64) -> int64 {kaesu 0;}
kata Node {value:int64;next:Node?;}
kaku head:Node?=mu;
waza allocate_one() -> int64 {kaku value=Node {value:7,next:mu};kaesu value.value;}
kaku i=0;aida(i<1000){head=Node {value:i,next:head};i=i+1;}
i=0;aida(i<8){kaku occupied=rt_collect(0);i=i+1;}
kaku started=rt_collect(2);
chant(allocate_one());chant(rt_collect(4));head=mu;chant(rt_collect(1));
