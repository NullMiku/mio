yobu "selfhost/frontend";
yobu "kiso/encoding/mochi";
yobu "kiso/aot/lower";
yobu "kiso/aot/macho";
yobu "kiso/aot/sign";
yobu "kiso/runtime/os/darwin";
yobu "kiso/fs";
yobu "kiso/os";
yobu "kiso/convert";
yobu "kiso/string";
// Native source-to-native integration builder. No manual roots, substituted
// collector, external compiler, or pre-generated Mochi in the production path.
waza main() -> unit {
kaku args=os.arguments();moshi(len(args)!=5 && len(args)!=6 && len(args)!=7 && len(args)!=8){os.exit(64);kaesu;}
kaku source=frontend.compile_source(args[1],args[2],args[3]);
moshi(source.error!=""){chant(source.error);os.exit(65);}
kaku decoded=mochi.decode(source.bytes);kaku file=decoded.value;
moshi(decoded.error!=mu){os.exit(66);}
moshi(file==mu){os.exit(66);kaesu;}
// Optional checked heap capacity for genuine dense LOS graph workloads.
// Default1MiB pressure/Minor cases remain unchanged.
kaku capacity=1048576;
moshi(len(args)>=6 && args[5]!="packet"){
 kaku requested=convert.parse_int(args[5]);moshi(requested==mu){os.exit(64);kaesu;}
 moshi(requested<1048576 || requested>67108864){os.exit(64);kaesu;}capacity=requested;
}
kaku queue_slots=32768;
moshi(len(args)>=7){kaku requested=convert.parse_int(args[6]);moshi(requested==mu){os.exit(64);kaesu;}moshi(requested<1 || requested>32768){os.exit(64);kaesu;}queue_slots=requested;}
kaku stress=iie;moshi(len(args)==8){moshi(args[7]!="stress"){os.exit(64);kaesu;}stress=hai;}
// Standard test-link name rewriting, as in pipeline.build_signed_test.
// It changes only the assertion channel, never worker roots or GC behavior.
moshi(len(args)==6 && args[5]=="packet"){
 kaku normal="$mma::mio/testing/runtime::report::153aff314d46bf25303f5c7917c019f53894e31277e171f138611964b6a5d967";
 kaku packet="$mma::mio/testing/runtime::report_packet::153aff314d46bf25303f5c7917c019f53894e31277e171f138611964b6a5d967";
 kaku at=0;aida(at<len(file.functions)){kaku fn=file.functions[at];moshi(fn.name==normal){file.functions[at]=mochi.Function {id:fn.id,name:packet,name_bytes:string.to_bytes(packet),parameter_count:fn.parameter_count,local_count:fn.local_count,returns_value:fn.returns_value,captures:fn.captures,instructions:fn.instructions};}at=at+1;}
}
// Audit artifact only; generated by the native frontend, never by the driver.
kaku dump=string.new_builder();kaku di=0;aida(di<len(file.functions)){kaku fn=file.functions[di];string.write_string(dump,string.concat(convert.format_int(fn.id),string.concat(" ",string.concat(fn.name,"\n"))));kaku dj=0;aida(dj<len(fn.instructions)){string.write_string(dump,string.concat(convert.format_int(int64(fn.instructions[dj])),","));dj=dj+1;}string.write_string(dump,"\n");di=di+1;}fs.write_all(string.concat(args[4],".mochi.txt"),string.to_bytes(string.builder_string(dump)));
kaku bindings:[]int64=[-1,-1,-1,-1];kaku names=["rt_start","rt_join","rt_wait","rt_collect"];kaku i=0;
aida(i<len(file.functions)){kaku j=0;aida(j<4){moshi(file.functions[i].name==names[j] || string.has_suffix(file.functions[i].name,string.concat("::",names[j]))){bindings[j]=i;}j=j+1;}i=i+1;}
kaku lowered=lower.compile_with_old_work_queue_stress(file,capacity,queue_slots,stress,bindings);kaku problem=lowered.error;
moshi(problem!=mu){chant(convert.format_int(lower.error_code(problem)));chant(convert.format_int(lower.error_detail(problem)));os.exit(67);}
kaku linked=darwin.executable_appended(macho.ImageSpec {words:lowered.words,constants:lowered.constants,globals:lowered.globals,patches:lowered.patches},darwin.worker_symbols(),lower.worker_root_words);
moshi(linked.error!=""){chant(linked.error);os.exit(68);}
kaku signed=sign.adhoc_linked(linked.bytes);moshi(signed.error!=""){chant(signed.error);os.exit(69);}
kaku written=fs.write_all(args[4],signed.bytes);moshi(written.error!=mu){os.exit(70);}
moshi(os.chmod(args[4],493)!=0){os.exit(71);}
}
main();
