// Real ordinary Mio source. No manual Root/TLS/frame publication.
waza rt_start(callback:() -> unit) -> int64 {kaesu 0;}
waza rt_join(handle:int64) -> int64 {kaesu 0;}
waza rt_wait(ns:int64) -> int64 {kaesu 0;}
waza rt_collect(operation:int64) -> int64 {kaesu 0;}
kata Node {value:int64;next:Node?;}
kaku head:Node?=mu;kaku discarded:Node?=mu;kaku control=0;kaku progress=0;kaku failures=0;
waza checksum(node:Node) -> int64 {kaesu node.value;}
waza arithmetic(n:int64) -> int64 {moshi(n<2){kaesu n;}kaesu arithmetic(n-1)+arithmetic(n-2);}
waza mutator() -> unit {
    aida(control==0){kaku waited=rt_wait(1000000);}
    aida(control==1){kaku node=head;moshi(node==mu){failures=1;kaesu;}
        moshi(checksum(node)!=7999 || arithmetic(4)!=3){failures=2;kaesu;}
        progress=progress+1;kaku observed=rt_collect(5);
    }
}
// Only this main-thread function ever holds the death witness. A blocked
// Worker cannot retain an earlier copy through a user global snapshot.
waza prepare_dead() -> unit {
    kaku dead=Node {value:99999,next:mu};kaku round=0;
    aida(round<8){kaku occupied=rt_collect(0);round=round+1;}
    moshi(dead.value!=99999){failures=3;}
}
kaku i=0;aida(i<8000){head=Node {value:i,next:head};i=i+1;}
kaku child=rt_start(mutator);prepare_dead();kaku started=rt_collect(2);control=1;
aida(progress<500 && failures==0){kaku waited=rt_wait(1000000);}
control=2;kaku joined=rt_join(child);kaku marked=rt_collect(3);kaku white=rt_collect(6);
chant(failures+joined+started);chant(progress>=500);chant(marked>=8000);chant(white>=1);chant(rt_collect(4));
head=mu;chant(rt_collect(1));
