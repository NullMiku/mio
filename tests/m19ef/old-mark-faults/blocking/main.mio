yobu "kiso/fs";yobu "kiso/array";
waza rt_start(callback:() -> unit) -> int64 {kaesu 0;}
waza rt_join(handle:int64) -> int64 {kaesu 0;}
waza rt_wait(ns:int64) -> int64 {kaesu 0;}
waza rt_collect(operation:int64) -> int64 {kaesu 0;}
kata Node {value:int64;}
kaku phase=0;kaku read_ok=0;kaku write_ok=0;kaku failures=0;
waza reader() -> unit {
 kaku buffer=array.make[uint8](131072,uint8(0));phase=1;
 kaku opened=fs.open_read("/Users/hatsunemiku/.codex/worktrees/m19ef-portable-gc/mio/build/m19ef-old-blocking-fifo");kaku file=opened.file;moshi(file==mu){read_ok=-1;kaesu;}
 kaku got=fs.read(file,buffer,0,1);kaku closed=fs.close(file);
 moshi(got.error==mu && got.count==1 && buffer[0]==uint8(90) && closed.error==mu){read_ok=1;}sore{read_ok=-2;}
}
waza writer() -> unit {
 aida(phase<2){kaku waited=rt_wait(100000);}
 kaku opened=fs.open_write("/Users/hatsunemiku/.codex/worktrees/m19ef-portable-gc/mio/build/m19ef-old-blocking-fifo");kaku file=opened.file;moshi(file==mu){write_ok=-1;kaesu;}
 kaku sent=fs.write(file,[uint8(90)],0,1);kaku closed=fs.close(file);moshi(sent.error==mu && sent.count==1 && closed.error==mu){write_ok=1;}sore{write_ok=-2;}
}
waza dead_witness() -> unit {kaku dead=Node {value:99999};kaku i=0;aida(i<8){kaku occupied=rt_collect(0);i=i+1;}moshi(dead.value!=99999){failures=1;}}
waza run() -> unit {
 kaku a=rt_start(reader);kaku b=rt_start(writer);aida(phase<1){kaku waited=rt_wait(100000);}
 dead_witness();kaku started=rt_collect(2);kaku i=0;aida(i<100){kaku occupied=rt_collect(0);kaku observed=rt_collect(5);i=i+1;}
 // Both genuine users remain blocked/parked. Remark must obtain their exact
 // current Root epoch without waiting for the FIFO to become readable.
 kaku marked=rt_collect(3);chant(marked>=4);chant(rt_collect(6)>=1);chant(rt_collect(4));
 phase=2;kaku ja=rt_join(a);kaku jb=rt_join(b);chant(failures+started+ja+jb);chant(read_ok);chant(write_ok);
}
run();chant(rt_collect(1));
