yobu "kiso/net/tcp";
yobu "kiso/io";

waza send_and_receive(connection: tcp.Connection?) -> unit {
    moshi (connection == mu) { kaesu; }
    kaku data: []uint8 = [uint8(77), uint8(105), uint8(111)];
    kaku sent = tcp.write_all(connection, data, 0, len(data));
    kaku sent_error = sent.error;
    chant(sent.count);
    chant(sent_error == mu);

    kaku echo: []uint8 = [0, 0, 0];
    kaku received = io.read_full(tcp.reader(connection), echo, 0, len(echo));
    kaku read_error = received.error;
    chant(received.count);
    chant(read_error == mu);
    chant(echo[0]);
    chant(echo[1]);
    chant(echo[2]);

    kaku closed = tcp.close(connection);
}

kaku address = tcp.ipv4(uint8(127), uint8(0), uint8(0), uint8(1), 18080);
kaku connected = tcp.connect(address);
chant(connected.error == mu);
send_and_receive(connected.connection);
