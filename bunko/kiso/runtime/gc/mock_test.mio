yobu "kiso/array";
// Contract-only recorder, no machine instructions and no claim of execution.
koukai kata MockTrace { operations: []RuntimeOp; errors: []string; }
koukai waza mock_trace() -> MockTrace { kaesu MockTrace { operations: [], errors: [] }; }
koukai waza mock_emit(trace: MockTrace, op: RuntimeOp) -> bool {
    moshi (!valid_operation(op)) { array.push(trace.errors, "INVALID_RUNTIME_OP"); kaesu iie; }
    array.push(trace.operations, op); kaesu hai;
}
