yobu "kiso/runtime/ir";
yobu "kiso/array";
// Native scalar ABI: x0..x6 arguments, x7 import table, x0 result. Every
// function preserves x19 and the return address; all virtual values are spills.
// CPU lowering owns registers, instruction choices, stack and code addresses.
koukai kata FunctionPatch {word:int64; name:string;}
waza ir_name(prefix:string,name:string) -> string {kaesu string.concat(prefix,string.concat("_",name));}
waza ir_emit(c:arm64.Assembler,word:arm64.Instruction) -> unit {arm64.assembler_emit(c,word);}
waza ir_number(c:arm64.Assembler,r:int64,value:int64) -> unit {
    kaku v=value;kaku negative=iie;moshi(v<0){v=-(v+1);negative=hai;}
    kaku shift=0;
    aida(shift<4){kaku part=v-(v/65536)*65536;
        moshi(shift==0){moshi(negative){ir_emit(c,arm64.movn_x(r,part,0));}sore{ir_emit(c,arm64.movz_x(r,part,0));}}
        sore{moshi(negative){part=65535-part;}ir_emit(c,arm64.movk_x(r,part,shift));}
        v=v/65536;shift=shift+1;
    }
}
waza ir_read(c:arm64.Assembler,virtual:int64,r:int64) -> unit {ir_emit(c,arm64.ldr_x(r,31,virtual*8));}
waza ir_write(c:arm64.Assembler,virtual:int64,r:int64) -> unit {ir_emit(c,arm64.str_x(r,31,virtual*8));}
waza ir_offset(c:arm64.Assembler,dst:int64,base:int64,offset:int64) -> unit {
    moshi(offset<=4095){ir_emit(c,arm64.add_imm_x(dst,base,offset,iie));}
    sore{ir_number(c,12,offset);ir_emit(c,arm64.add_x(dst,base,12));}
}
koukai waza emit_program(c:arm64.Assembler,functions:[]ir.Function,bindings:[]ir.Binding,slots:int64,prefix:string) -> string {
    // Validate the complete program before emitting any machine code.
    kaku fi=0;
    aida(fi<len(functions)){
        kaku f=functions[fi];moshi(f.name==""){kaesu "INVALID_RUNTIME_FUNCTION";}
        kaku j=0;aida(j<fi){moshi(functions[j].name==f.name){kaesu "DUPLICATE_RUNTIME_FUNCTION";}j=j+1;}
        kaku si=0;aida(si<len(f.steps)){
            kaku s=f.steps[si];moshi(!ir.valid_step(s)){kaesu "INVALID_RUNTIME_STEP";}
            moshi(s.kind==ir.label){
                moshi(s.name=="__epilogue"){kaesu "RESERVED_RUNTIME_LABEL";}
                j=0;aida(j<si){moshi(f.steps[j].kind==ir.label && f.steps[j].name==s.name){kaesu "DUPLICATE_RUNTIME_LABEL";}j=j+1;}
            }
            moshi(s.kind==ir.compare_exchange && len(s.arguments)!=1){kaesu "INVALID_CAS_ARGUMENT";}
            moshi(s.kind==ir.fetch_add || s.kind==ir.compare_exchange){
                kaku operation=gc.atomic_add;moshi(s.kind==ir.compare_exchange){operation=gc.atomic_cas;}
                moshi(!gc.valid_operation(gc.RuntimeOp {kind:operation,address:0,value:1,expected:2,result:3,status:4,order:s.order,failure_order:s.failure_order,alignment:8,epoch:0})){kaesu "INVALID_RUNTIME_ATOMIC_ORDER";}
            }
            moshi(s.kind==ir.system){
                kaku found=iie;j=0;aida(j<len(bindings)){
                    kaku b=bindings[j];moshi(b.operation==s.immediate){
                        moshi(found || b.slot<0 || b.slot>=slots || len(b.arguments)>7 || (b.result_bits!=32 && b.result_bits!=64)){kaesu "INVALID_RUNTIME_BINDING";}found=hai;
                        kaku a=0;aida(a<len(b.arguments)){moshi(b.arguments[a]>=len(s.arguments) || b.arguments[a]< -65536){kaesu "INVALID_RUNTIME_ARGUMENT";}a=a+1;}
                    }j=j+1;
                }moshi(!found){kaesu "NOT_SUPPORTED_RUNTIME_OPERATION";}
            }
            moshi(s.kind==ir.invoke || s.kind==ir.function_address){
                kaku found=iie;j=0;aida(j<len(functions)){moshi(functions[j].name==s.name){found=hai;}j=j+1;}moshi(!found){kaesu "UNDEFINED_RUNTIME_FUNCTION";}
            }
            moshi(s.kind==ir.jump || s.kind==ir.zero || s.kind==ir.nonzero){
                kaku found=iie;j=0;aida(j<len(f.steps)){moshi(f.steps[j].kind==ir.label && f.steps[j].name==s.name){found=hai;}j=j+1;}moshi(!found){kaesu "UNDEFINED_RUNTIME_LABEL";}
            }
            si=si+1;
        }fi=fi+1;
    }
    kaku patches:[]FunctionPatch=[];fi=0;
    aida(fi<len(functions)){
        kaku f=functions[fi];kaku scope=ir_name(prefix,f.name);arm64.assembler_label(c,scope);
        ir_emit(c,arm64.sub_imm_x(31,31,352,iie));ir_emit(c,arm64.str_x(19,31,320));ir_emit(c,arm64.str_x(30,31,328));
        ir_emit(c,arm64.add_imm_x(19,7,0,iie));kaku i=0;
        aida(i<7){ir_write(c,i,i);i=i+1;}
        // Remaining virtual registers start at zero, including unused args.
        aida(i<32){ir_write(c,i,31);i=i+1;}
        i=0;aida(i<len(f.steps)){
            kaku s=f.steps[i];kaku kind=s.kind;
            moshi(kind==ir.constant){ir_number(c,9,s.immediate);ir_write(c,s.destination,9);}
            moshi(kind==ir.copy){ir_read(c,s.left,9);ir_write(c,s.destination,9);}
            moshi(kind==ir.address || kind==ir.load || kind==ir.store || kind==ir.acquire_load || kind==ir.release_store){
                ir_read(c,s.left,9);ir_offset(c,9,9,s.immediate);
                moshi(kind==ir.address){ir_write(c,s.destination,9);}
                moshi(kind==ir.load || kind==ir.acquire_load){moshi(kind==ir.load){ir_emit(c,arm64.ldr_x(10,9,0));}sore{ir_emit(c,arm64.ldar_x(10,9));}ir_write(c,s.destination,10);}
                moshi(kind==ir.store || kind==ir.release_store){ir_read(c,s.right,10);moshi(kind==ir.store){ir_emit(c,arm64.str_x(10,9,0));}sore{ir_emit(c,arm64.stlr_x(10,9));}}
            }
            moshi(kind>=ir.add && kind<=ir.less_unsigned){
                ir_read(c,s.left,9);ir_read(c,s.right,10);
                moshi(kind==ir.add){ir_emit(c,arm64.add_x(11,9,10));}
                moshi(kind==ir.subtract){ir_emit(c,arm64.sub_x(11,9,10));}
                moshi(kind==ir.multiply){ir_emit(c,arm64.mul_x(11,9,10));}
                moshi(kind==ir.divide_unsigned){ir_emit(c,arm64.udiv_x(11,9,10));}
                moshi(kind==ir.equal || kind==ir.less_unsigned){ir_emit(c,arm64.cmp_x(9,10));kaku condition=0;moshi(kind==ir.less_unsigned){condition=3;}ir_emit(c,arm64.cset_w(11,condition));}
                ir_write(c,s.destination,11);
            }
            moshi(kind==ir.label){arm64.assembler_label(c,ir_name(scope,s.name));}
            moshi(kind==ir.jump){arm64.assembler_b(c,ir_name(scope,s.name));}
            moshi(kind==ir.zero || kind==ir.nonzero){ir_read(c,s.left,9);moshi(kind==ir.zero){arm64.assembler_cbz_x(c,9,ir_name(scope,s.name));}sore{arm64.assembler_cbnz_x(c,9,ir_name(scope,s.name));}}
            moshi(kind==ir.system){
                kaku bi=0;aida(bi<len(bindings)){
                    kaku b=bindings[bi];moshi(b.operation==s.immediate){kaku ai=0;aida(ai<len(b.arguments)){
                        kaku selector=b.arguments[ai];moshi(selector<0){ir_number(c,ai,-selector-1);}sore{ir_read(c,s.arguments[selector],ai);}ai=ai+1;
                    }emit_import_call(c,19,b.slot,slots);moshi(b.result_bits==32){ir_emit(c,arm64.lsl_x(0,0,32));ir_emit(c,arm64.lsr_x(0,0,32));}}bi=bi+1;
                }ir_write(c,s.destination,0);
            }
            moshi(kind==ir.invoke){kaku ai=0;aida(ai<len(s.arguments)){ir_read(c,s.arguments[ai],ai);ai=ai+1;}ir_emit(c,arm64.add_imm_x(7,19,0,iie));arm64.assembler_bl(c,ir_name(prefix,s.name));ir_write(c,s.destination,0);}
            moshi(kind==ir.function_address){array.push(patches,FunctionPatch {word:len(c.words),name:ir_name(prefix,s.name)});ir_emit(c,arm64.movz_x(9,0,0));ir_write(c,s.destination,9);}
            moshi(kind==ir.imports){ir_read(c,s.left,19);}
            moshi(kind==ir.scratch_address){ir_emit(c,arm64.add_imm_x(9,31,256+s.immediate,iie));ir_write(c,s.destination,9);}
            moshi(kind==ir.fetch_add || kind==ir.compare_exchange){
                ir_read(c,s.left,0);ir_read(c,s.right,1);moshi(kind==ir.compare_exchange){moshi(len(s.arguments)!=1){kaesu "INVALID_CAS_ARGUMENT";}ir_read(c,s.arguments[0],2);}
                kaku atomic_kind=gc.atomic_add;moshi(kind==ir.compare_exchange){atomic_kind=gc.atomic_cas;}
                kaku error=emit_atomic(c,gc.RuntimeOp {kind:atomic_kind,address:0,value:1,expected:2,result:3,status:4,order:s.order,failure_order:s.failure_order,alignment:8,epoch:0});moshi(error!=""){kaesu error;}ir_write(c,s.destination,0);
            }
            moshi(kind==ir.result){ir_read(c,s.left,0);arm64.assembler_b(c,ir_name(scope,"__epilogue"));}
            i=i+1;
        }
        ir_number(c,0,0);arm64.assembler_label(c,ir_name(scope,"__epilogue"));ir_emit(c,arm64.ldr_x(19,31,320));ir_emit(c,arm64.ldr_x(30,31,328));ir_emit(c,arm64.add_imm_x(31,31,352,iie));ir_emit(c,arm64.ret());fi=fi+1;
    }
    fi=0;aida(fi<len(patches)){kaku p=patches[fi];kaku at=arm64.assembler_label_word(c,p.name);kaku encoded=arm64.adr(9,(at-p.word)*4);moshi(encoded.error!=mu){kaesu "RUNTIME_FUNCTION_ADDRESS_OUT_OF_RANGE";}c.words[p.word]=encoded.word;fi=fi+1;}
    kaesu "";
}
