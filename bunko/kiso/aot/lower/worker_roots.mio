// Darwin/AArch64 平台的可移植托管 Mutator 协议实现（Worker 根管理运行时）。
// 内部桥接层为每个并发存活的 Worker 线程（外加主线程）各分配一个独立的 8800 字节上下文槽位（共 worker_slots 个），
// 包含原生上下文、不透明锁以及用于 STW（Stop-The-World）的根快照缓冲区。
// 当所有槽位均被占用时再启动线程会显式报错（不会静默等待），由上层 thread API 转换为 -11 错误码。
koukai teisu worker_slots = 128;
koukai teisu word_blocks = 16384;

// 通道离堆控制字池：位于全部线程上下文之后，共 word_blocks 个块，每块 8 个 64 位字。
// 池中第 0 个字记录已分配块计数；句柄 h（1..word_blocks）对应的块起始于第 8*h 个字。
// 已分配的块在进程生命周期内永不复用，确保正在执行 send/receive 的线程绝不会访问到被回收或复用的内存；
// 第 16385 次 words_new 将返回 -12（ENOMEM）。
// 每个线程上下文占用 wr_ctx_words 字：前段为固定字段，从 wr_snapshot 起为收集器的根快照区（容量 wr_snapshot_capacity）。
teisu wr_ctx_words = 5200;
koukai teisu worker_root_words = (worker_slots + 1) * wr_ctx_words + 4 + (word_blocks + 1) * 8;
teisu wr_stride = 41600;

// 上下文 +8800 偏移：Worker 入口函数返回的整数值（无返回值函数固定写入 0），由 join 读取并返回给调用方。
teisu wr_result = 8800;
// 上下文 +8808 偏移：原子认领标志，线程启动认领后为非 0，直到 join 完成后清零。
teisu wr_claim = 8808;
// 上下文 +8816 偏移：槽位代际计数（每次 join 后递增，编码进线程句柄高位以检测过期句柄）。
// 上下文 +8824 偏移：当前线程最近一次 join 的状态码（0 表示正常，22 表示无效句柄）。
teisu wr_generation = 8816;
teisu wr_join_status = 8824;
teisu wr_snapshot = 9000;
// 4000 个根容量：128 个并发存活线程在 STW 快照时每线程可能需要数十个根槽位（1000 容量在实测中会溢出导致 gc_scan_roots 失败）。
teisu wr_snapshot_capacity = 4000;

waza worker_roots_enabled(c: arm64.Assembler) -> bool {
    kaesu arm64.assembler_label_word(c, "worker_roots_enabled") >= 0;
}

waza emit_print_boundary(c: arm64.Assembler) -> unit {
    moshi (worker_roots_enabled(c)) {
        emit(c, arm64.sub_imm_x(31, 31, 16, iie));
        emit(c, arm64.str_x(30, 31, 0));
        arm64.assembler_bl(c, "attached_native_enter");
        emit(c, arm64.svc(128));
        arm64.assembler_bl(c, "attached_native_leave");
        emit(c, arm64.ldr_x(30, 31, 0));
        emit(c, arm64.add_imm_x(31, 31, 16, iie));
    } sore {
        emit(c, arm64.svc(128));
    }
}

waza wr_emit(c: arm64.Assembler, w: arm64.Instruction) -> unit {
    emit(c, w);
}

waza wr_ctx(c: arm64.Assembler, p: []macho.AddressPatch, first: int64, r: int64, slot: int64) -> unit {
    attached_data_address(c, p, first + worker_import_slots(c) + slot * wr_ctx_words, r);
}

waza wr_pool(c: arm64.Assembler, p: []macho.AddressPatch, first: int64, r: int64) -> unit {
    attached_data_address(c, p, first + worker_import_slots(c) + (worker_slots + 1) * wr_ctx_words, r);
}

waza wr_neg(c: arm64.Assembler, r: int64, n: int64) -> unit {
    wr_num(c, r, n);
    emit(c, arm64.sub_x(r, 31, r));
}

// 校验句柄 x0 与字下标 x1 的合法性，并将目标字地址写入 x13；非法时跳转到 bad。会破坏 x9-x14。
waza word_address(c: arm64.Assembler, p: []macho.AddressPatch, first: int64, bad: string) -> unit {
    arm64.assembler_cbz_x(c, 0, bad);
    wr_num(c, 14, word_blocks);
    emit(c, arm64.cmp_x(0, 14));
    arm64.assembler_b_cond(c, 8, bad);
    emit(c, arm64.cmp_imm_x(1, 8, iie));
    arm64.assembler_b_cond(c, 2, bad);

    wr_pool(c, p, first, 9);
    emit(c, arm64.ldr_x(10, 9, 0));
    emit(c, arm64.cmp_x(0, 10));
    arm64.assembler_b_cond(c, 8, bad);

    wr_num(c, 12, 8);
    emit(c, arm64.mul_x(11, 0, 12));
    emit(c, arm64.add_x(11, 11, 1));
    emit(c, arm64.mul_x(11, 11, 12));
    emit(c, arm64.add_x(13, 9, 11));
}

waza emit_word_natives(c: arm64.Assembler, p: []macho.AddressPatch, first: int64) -> unit {
    // words_new(n)：n 必须在 1..8 之间，通过 LDXR/STXR 原子递增池计数分配新块。
    arm64.assembler_label(c, "native_words_new");
    emit(c, arm64.cmp_imm_x(0, 1, iie));
    arm64.assembler_b_cond(c, 11, "native_word_bad");
    emit(c, arm64.cmp_imm_x(0, 8, iie));
    arm64.assembler_b_cond(c, 12, "native_word_bad");

    wr_pool(c, p, first, 9);
    arm64.assembler_label(c, "native_words_new_retry");
    emit(c, arm64.ldxr_x(10, 9, hai));
    wr_num(c, 14, word_blocks);
    emit(c, arm64.cmp_x(10, 14));
    arm64.assembler_b_cond(c, 2, "native_words_full");
    emit(c, arm64.add_imm_x(11, 10, 1, iie));
    emit(c, arm64.stxr_x(12, 11, 9, hai));
    arm64.assembler_cbnz_x(c, 12, "native_words_new_retry");
    emit(c, arm64.add_imm_x(0, 10, 1, iie));
    emit(c, arm64.ret());

    arm64.assembler_label(c, "native_words_full");
    wr_neg(c, 0, 12);
    emit(c, arm64.ret());

    arm64.assembler_label(c, "native_word_bad");
    wr_neg(c, 0, 22);
    emit(c, arm64.ret());

    // words_free(h, n)：控制块在进程生命周期内保持映射，因此故意为空操作。
    arm64.assembler_label(c, "native_words_free");
    emit(c, arm64.movz_x(0, 0, 0));
    emit(c, arm64.ret());

    arm64.assembler_label(c, "native_join_status");
    emit(c, arm64.sub_imm_x(31, 31, 16, iie));
    emit(c, arm64.str_x(30, 31, 0));
    arm64.assembler_bl(c, "attached_join_status");
    emit(c, arm64.ldr_x(30, 31, 0));
    emit(c, arm64.add_imm_x(31, 31, 16, iie));
    emit(c, arm64.ret());

    // word_get 使用 acquire 语义读取；word_set 使用 release 语义写入并附加 dmb ish 保证全序可见性。
    arm64.assembler_label(c, "native_word_get");
    word_address(c, p, first, "native_word_bad");
    emit(c, arm64.ldar_x(0, 13));
    emit(c, arm64.ret());

    arm64.assembler_label(c, "native_word_set");
    word_address(c, p, first, "native_word_bad");
    emit(c, arm64.stlr_x(2, 13));
    emit(c, arm64.dmb_ish());
    emit(c, arm64.movz_x(0, 0, 0));
    emit(c, arm64.ret());

    // word_cas(h, i, expected, new) -> 返回实际读到的旧值（配合 dmb ish 提供全屏障语义）。
    arm64.assembler_label(c, "native_word_cas");
    word_address(c, p, first, "native_word_bad");
    arm64.assembler_label(c, "native_word_cas_retry");
    emit(c, arm64.ldxr_x(14, 13, hai));
    emit(c, arm64.cmp_x(14, 2));
    arm64.assembler_b_cond(c, 1, "native_word_cas_done");
    emit(c, arm64.stxr_x(15, 3, 13, hai));
    arm64.assembler_cbnz_x(c, 15, "native_word_cas_retry");
    arm64.assembler_label(c, "native_word_cas_done");
    move_x(c, 0, 14);
    emit(c, arm64.dmb_ish());
    emit(c, arm64.ret());

    // word_add(h, i, delta) -> 返回累加前的旧值（配合 dmb ish 提供全屏障语义）。
    arm64.assembler_label(c, "native_word_add");
    word_address(c, p, first, "native_word_bad");
    arm64.assembler_label(c, "native_word_add_retry");
    emit(c, arm64.ldxr_x(14, 13, hai));
    emit(c, arm64.add_x(10, 14, 2));
    emit(c, arm64.stxr_x(15, 10, 13, hai));
    arm64.assembler_cbnz_x(c, 15, "native_word_add_retry");
    move_x(c, 0, 14);
    emit(c, arm64.dmb_ish());
    emit(c, arm64.ret());

    // word_wake(h, i, n)：通过 Darwin 内核 ulock_wake（系统调用号 516）唤醒等待者。
    // count == 1 时仅唤醒一个等待者（op=5，用于互斥锁交接）；否则附加 0x100 标志唤醒全部等待者（op=261）。若无人等待则为空操作。
    arm64.assembler_label(c, "native_word_wake");
    word_address(c, p, first, "native_word_bad");
    emit(c, arm64.cmp_imm_x(2, 1, iie));
    arm64.assembler_b_cond(c, 0, "native_word_wake_one");
    wr_num(c, 0, 261);
    arm64.assembler_b(c, "native_word_wake_go");
    arm64.assembler_label(c, "native_word_wake_one");
    wr_num(c, 0, 5);
    arm64.assembler_label(c, "native_word_wake_go");
    move_x(c, 1, 13);
    emit(c, arm64.movz_x(2, 0, 0));
    wr_num(c, 16, 516);
    emit(c, arm64.svc(128));
    emit(c, arm64.movz_x(0, 0, 0));
    emit(c, arm64.ret());

    // word_wait(h, i, expected)：当字的值不等于 expected、被唤醒或超过 100 ms 安全超时后返回（由调用方重新检查条件）。
    arm64.assembler_label(c, "native_word_wait");
    word_address(c, p, first, "native_word_bad");
    emit(c, arm64.sub_imm_x(31, 31, 48, iie));
    emit(c, arm64.str_x(30, 31, 0));
    emit(c, arm64.str_x(0, 31, 8));
    emit(c, arm64.str_x(1, 31, 16));
    emit(c, arm64.str_x(2, 31, 24));

    // 短暂持锁/状态切换是常见情况：先进行有界次数（4000 次）的只读自旋（微秒级完成，无需 Safepoint）再进入内核休眠。
    wr_num(c, 15, 4000);
    arm64.assembler_label(c, "native_word_wait_spin");
    emit(c, arm64.ldar_x(14, 13));
    emit(c, arm64.cmp_x(14, 2));
    arm64.assembler_b_cond(c, 1, "native_word_wait_done");
    emit(c, arm64.sub_imm_x(15, 15, 1, iie));
    arm64.assembler_cbnz_x(c, 15, "native_word_wait_spin");

    // 自旋未果后通过 ulock_wait（系统调用号 515，64 位比较并等待）在内核阻塞，直至被唤醒或 100 ms 超时。
    // 整个阻塞期间线程处于 attached_native_enter/leave 包裹的阻塞区（与阻塞写一致）：STW GC 不会等待该线程且其根已发布；
    // 离开阻塞区时若 GC 正在进行则会自动停靠（park）。
    wr_num(c, 0, 5);
    move_x(c, 1, 13);
    emit(c, arm64.ldr_x(2, 31, 24));
    wr_num(c, 3, 100000);
    wr_num(c, 16, 515);
    arm64.assembler_bl(c, "attached_native_enter");
    emit(c, arm64.svc(128));
    arm64.assembler_bl(c, "attached_native_leave");

    arm64.assembler_label(c, "native_word_wait_done");
    emit(c, arm64.movz_x(0, 0, 0));
    emit(c, arm64.ldr_x(30, 31, 0));
    emit(c, arm64.add_imm_x(31, 31, 48, iie));
    emit(c, arm64.ret());
}

waza wr_imports(c: arm64.Assembler, p: []macho.AddressPatch, first: int64) -> unit {
    attached_data_address(c, p, first, 7);
}

waza wr_num(c: arm64.Assembler, r: int64, n: int64) -> unit {
    move_bits(c, r, uint32(0), uint32(n));
}

waza wr_current(c: arm64.Assembler, p: []macho.AddressPatch, first: int64) -> unit {
    wr_ctx(c, p, first, 0, 0);
    wr_imports(c, p, first);
    emit(c, arm64.ldr_x(0, 0, gc.thread_key));
    aarch64.emit_import_call(c, 7, 5, 28);
    arm64.assembler_cbz_x(c, 0, "runtime_error");

    wr_ctx(c, p, first, 9, 0);
    emit(c, arm64.add_imm_x(9, 9, 400, iie));
    emit(c, arm64.ldr_x(10, 0, gc.thread_registry));
    emit(c, arm64.cmp_x(9, 10));
    arm64.assembler_b_cond(c, 1, "runtime_error");
    emit(c, arm64.ldr_x(10, 0, gc.thread_registered));
    arm64.assembler_cbz_x(c, 10, "runtime_error");

    emit(c, arm64.add_imm_x(9, 0, gc.thread_shadow, iie));
    emit(c, arm64.stlr_x(24, 9));
    wr_imports(c, p, first);
}

// 运行时调用失败时直接终止进程。在公开线程构建中，退出码编码了失败的调用及其返回值（30 + 4 * call + min(result, 3)）；
// 证据测试构建仍保持普通运行时错误退出码 1。
waza wr_call(c: arm64.Assembler, name: string) -> unit {
    arm64.assembler_bl(c, string.concat("attached_", name));
    moshi (arm64.assembler_label_word(c, "worker_evidence") >= 0) {
        arm64.assembler_cbnz_x(c, 0, "runtime_error");
    } sore {
        kaku names = [
            "gc_block_enter", "gc_block_leave", "thread_open_shared", "thread_wait_started",
            "thread_wait_completion", "thread_close", "gc_mutator_poll", "gc_heap_enter",
            "thread_attach", "thread_enter", "thread_leave", "gc_scan_roots"
        ];
        kaku id = 12;
        kaku i = 0;
        aida (i < len(names)) {
            moshi (names[i] == name) { id = i; }
            i = i + 1;
        }
        kaku ok = block_label("wr_ok_", len(c.words));
        arm64.assembler_cbz_x(c, 0, ok);
        emit(c, arm64.cmp_imm_x(0, 3, iie));
        kaku keep = block_label("wr_rc_", len(c.words));
        arm64.assembler_b_cond(c, 9, keep);
        emit(c, arm64.movz_x(0, 3, 0));
        arm64.assembler_label(c, keep);
        emit(c, arm64.add_imm_x(0, 0, 30 + id * 4, iie));
        emit(c, arm64.movz_x(16, 1, 0));
        emit(c, arm64.svc(128));
        arm64.assembler_label(c, ok);
    }
}

waza wr_poll(c: arm64.Assembler, p: []macho.AddressPatch, first: int64, operation: string) -> unit {
    wr_current(c, p, first);
    move_x(c, 1, 24);
    wr_call(c, operation);
}

waza wr_addr(c: arm64.Assembler, r: int64, base: int64, offset: int64) -> unit {
    wr_num(c, 12, offset);
    emit(c, arm64.add_x(r, base, 12));
}

waza wr_increment(c: arm64.Assembler, ctx: int64, offset: int64) -> unit {
    emit(c, arm64.ldr_x(10, ctx, offset));
    emit(c, arm64.add_imm_x(10, 10, 1, iie));
    emit(c, arm64.str_x(10, ctx, offset));
}

waza wr_snapshot_trace(c: arm64.Assembler, ctx: int64) -> unit {
    kaku done = block_label("worker_snapshot_max_", len(c.words));
    emit(c, arm64.ldr_x(10, ctx, wr_snapshot + 8));
    emit(c, arm64.ldr_x(11, ctx, 8672));
    emit(c, arm64.cmp_x(10, 11));
    arm64.assembler_b_cond(c, 9, done);
    emit(c, arm64.str_x(10, ctx, 8672));
    arm64.assembler_label(c, done);

    emit(c, arm64.ldr_x(11, ctx, gc.thread_registry));
    emit(c, arm64.add_imm_x(11, 11, gc.gc_registry_epoch, iie));
    emit(c, arm64.ldar_x(10, 11));
    emit(c, arm64.str_x(10, ctx, 8680));
}

waza emit_worker_root_runtime(c: arm64.Assembler, p: []macho.AddressPatch, first: int64, queue_slots: int64) -> string {
    attached_save(c, "attached_roots_init");
    wr_ctx(c, p, first, 0, 0);
    wr_imports(c, p, first);
    emit(c, arm64.str_x(7, 0, gc.thread_imports));
    wr_num(c, 9, 3);
    emit(c, arm64.str_x(9, 0, gc.thread_version));
    emit(c, arm64.add_imm_x(10, 0, 288, iie));
    emit(c, arm64.str_x(10, 0, gc.thread_mutex));
    emit(c, arm64.add_imm_x(10, 0, 352, iie));
    emit(c, arm64.str_x(10, 0, gc.thread_condition));
    emit(c, arm64.add_imm_x(10, 0, 400, iie));
    emit(c, arm64.str_x(10, 0, gc.thread_registry));
    emit(c, arm64.str_x(9, 10, 0));

    kaku relocations: []int64 = [];
    kaku callbacks = ["attached_gc_snapshot_root", "worker_heap_collect", "worker_heap_alloc"];
    moshi (old_sweep_enabled(c)) {
        array.append_all(callbacks, ["worker_sweep_account", "worker_sweep_unmap"]);
    }
    kaku i = 0;
    aida (i < len(callbacks)) {
        array.push(relocations, len(c.words));
        emit(c, arm64.movz_x(9, 0, 0));
        emit(c, arm64.str_x(9, 7, (25 + i) * 8));
        i = i + 1;
    }

    moshi (old_mark_proto_enabled(c)) {
        wr_ctx(c, p, first, 9, 0);
        wr_addr(c, 9, 9, 8696);
        kaku link_slot = 0;
        aida (link_slot < 3) {
            wr_ctx(c, p, first, 10, link_slot);
            emit(c, arm64.str_x(9, 10, 8704));
            link_slot = link_slot + 1;
        }
    }
    wr_call(c, "thread_attach");
    attached_restore(c);

    kaku names = ["attached_roots_publish", "attached_roots_poll", "attached_heap_enter"];
    i = 0;
    aida (i < 3) {
        attached_save(c, names[i]);
        wr_current(c, p, first);
        wr_increment(c, 0, 488);
        moshi (i == 1) {
            wr_increment(c, 0, 480);
            move_x(c, 1, 24);
            wr_call(c, "gc_mutator_poll");
        }
        moshi (i == 2) {
            move_x(c, 1, 24);
            wr_call(c, "gc_heap_enter");
        }
        attached_restore(c);
        i = i + 1;
    }

    // 遗留分配器可能会触发 GC，因此必须先让协调器完成全局根快照，并保持 stopped epoch 直至下一个已求解字节码轮询。
    attached_save(c, "runtime_alloc");
    emit(c, arm64.sub_imm_x(31, 31, 32, iie));
    emit(c, arm64.str_x(24, 31, 0));
    wr_current(c, p, first);
    emit(c, arm64.str_x(0, 31, 16));
    move_x(c, 1, 24);
    wr_call(c, "gc_heap_enter");
    moshi (old_mark_proto_enabled(c)) { arm64.assembler_bl(c, "old_pause_epoch"); }

    emit(c, arm64.ldr_x(0, 31, 16));
    wr_addr(c, 1, 0, wr_snapshot);
    emit(c, arm64.str_x(31, 1, 0));
    emit(c, arm64.str_x(31, 1, 8));
    wr_imports(c, p, first);
    wr_call(c, "gc_scan_roots");
    emit(c, arm64.ldr_x(9, 31, 16));
    wr_snapshot_trace(c, 9);
    emit(c, arm64.ldr_x(9, 31, 16));
    wr_addr(c, 24, 9, wr_snapshot);
    emit(c, arm64.ldr_x(0, 31, 176));
    emit(c, arm64.ldr_x(1, 31, 184));
    arm64.assembler_bl(c, "runtime_alloc_legacy");
    emit(c, arm64.str_x(0, 31, 176));
    emit(c, arm64.ldr_x(24, 31, 0));
    emit(c, arm64.add_imm_x(31, 31, 32, iie));
    attached_restore(c);

    // pthread 入口直接调用编译后的闭包；其引导根（bootstrap root）在注册前自动生成并持续存活至退出。
    stw_bridge_enter(c, "worker_user_entry");
    move_x(c, 26, 0);
    emit(c, arm64.ldr_x(7, 26, gc.thread_imports));
    wr_call(c, "thread_enter");
    emit(c, arm64.ldr_x(7, 26, gc.thread_imports));
    arm64.assembler_bl(c, "attached_platform_now");
    emit(c, arm64.str_x(0, 26, 8656));
    emit(c, arm64.ldr_x(23, 26, 568));
    emit(c, arm64.ldr_x(28, 26, 8640));
    emit(c, arm64.add_imm_x(24, 26, 544, iie));
    emit(c, arm64.movz_x(22, 0, 0));
    emit(c, arm64.movz_x(27, 0, 0));
    emit(c, arm64.ldr_x(9, 26, gc.thread_user));
    emit(c, arm64.ldr_x(25, 9, 40));
    emit(c, arm64.ldr_x(16, 9, 32));
    emit(c, arm64.blr_x(16));

    // 无返回值入口函数会在 x0 遗留垃圾值：此时统一发布 0，有返回值时保留原整数结果。
    emit(c, arm64.ldr_x(9, 26, gc.thread_user));
    emit(c, arm64.ldr_x(10, 9, 24));
    arm64.assembler_cbnz_x(c, 10, "worker_result_keep");
    emit(c, arm64.movz_x(0, 0, 0));
    arm64.assembler_label(c, "worker_result_keep");
    emit(c, arm64.str_x(0, 26, wr_result));

    move_x(c, 0, 26);
    move_x(c, 1, 24);
    emit(c, arm64.ldr_x(7, 26, gc.thread_imports));
    wr_call(c, "gc_mutator_poll");
    moshi (arm64.assembler_label_word(c, "nativefs_cleanup") >= 0) {
        arm64.assembler_bl(c, "nativefs_cleanup");
    }
    emit(c, arm64.ldr_x(7, 26, gc.thread_imports));
    arm64.assembler_bl(c, "attached_platform_now");
    emit(c, arm64.str_x(0, 26, 8664));
    move_x(c, 0, 26);
    wr_call(c, "thread_leave");
    emit(c, arm64.str_x(31, 26, 560));
    emit(c, arm64.str_x(31, 26, gc.thread_user));
    emit(c, arm64.movz_x(0, 0, 0));
    stw_bridge_leave(c);

    // attached_worker_start 仅借用主线程的 TLS Key，绝不删除它。
    // 父线程根在子线程完成注册并发布根之前保持在阻塞态固定。
    attached_save(c, "attached_worker_start");
    wr_current(c, p, first);
    wr_ctx(c, p, first, 10, 1);
    wr_num(c, 12, worker_slots);
    wr_num(c, 13, wr_stride);

    arm64.assembler_label(c, "worker_slot_scan");
    emit(c, arm64.ldr_x(11, 10, gc.thread_owns_handle));
    arm64.assembler_cbnz_x(c, 11, "worker_slot_next");
    // 任意已注册线程均可启动子线程，因此通过 wr_claim 原子认领空闲槽位（由 join 释放）。
    wr_num(c, 15, wr_claim);
    emit(c, arm64.add_x(14, 10, 15));
    arm64.assembler_label(c, "worker_slot_claim");
    emit(c, arm64.ldxr_x(11, 14, hai));
    arm64.assembler_cbnz_x(c, 11, "worker_slot_next");
    emit(c, arm64.movz_x(11, 1, 0));
    emit(c, arm64.stxr_x(9, 11, 14, hai));
    arm64.assembler_cbnz_x(c, 9, "worker_slot_claim");
    arm64.assembler_b(c, "worker_slot_ready");

    arm64.assembler_label(c, "worker_slot_next");
    emit(c, arm64.add_x(10, 10, 13));
    emit(c, arm64.sub_imm_x(12, 12, 1, iie));
    arm64.assembler_cbnz_x(c, 12, "worker_slot_scan");
    // 所有槽位均已占用：返回 -11（未创建任何线程）而非中止进程。
    wr_neg(c, 9, 11);
    emit(c, arm64.str_x(9, 31, 144));
    attached_restore(c);

    arm64.assembler_label(c, "worker_slot_ready");
    emit(c, arm64.sub_imm_x(31, 31, 32, iie));
    emit(c, arm64.str_x(10, 31, 0));
    wr_imports(c, p, first);
    emit(c, arm64.str_x(7, 10, gc.thread_imports));
    wr_num(c, 11, 3);
    emit(c, arm64.str_x(11, 10, gc.thread_version));
    wr_ctx(c, p, first, 9, 0);
    emit(c, arm64.ldr_x(11, 9, gc.thread_key));
    emit(c, arm64.str_x(11, 10, gc.thread_key));
    emit(c, arm64.add_imm_x(9, 9, 400, iie));
    emit(c, arm64.str_x(9, 10, gc.thread_registry));
    emit(c, arm64.add_imm_x(9, 10, 288, iie));
    emit(c, arm64.str_x(9, 10, gc.thread_mutex));
    emit(c, arm64.add_imm_x(9, 10, 352, iie));
    emit(c, arm64.str_x(9, 10, gc.thread_condition));

    emit(c, arm64.ldr_x(9, 31, 176));
    arm64.assembler_cbz_x(c, 9, "runtime_error");
    emit(c, arm64.ldr_x(11, 9, 0));
    emit(c, arm64.cmp_imm_x(11, 4, iie));
    arm64.assembler_b_cond(c, 1, "runtime_error");
    emit(c, arm64.ldr_x(11, 9, 16));
    arm64.assembler_cbnz_x(c, 11, "runtime_error");
    emit(c, arm64.str_x(9, 10, gc.thread_user));
    emit(c, arm64.str_x(9, 10, 560));
    emit(c, arm64.str_x(31, 10, 544));
    wr_num(c, 11, 1);
    emit(c, arm64.str_x(11, 10, 552));
    emit(c, arm64.add_imm_x(9, 10, 544, iie));
    emit(c, arm64.str_x(9, 10, gc.thread_shadow));
    emit(c, arm64.str_x(23, 10, 568));
    emit(c, arm64.str_x(28, 10, 8640));

    kaku worker_address = len(c.words);
    emit(c, arm64.movz_x(9, 0, 0));
    emit(c, arm64.str_x(9, 10, gc.thread_entry));

    wr_poll(c, p, first, "gc_block_enter");
    emit(c, arm64.ldr_x(0, 31, 0));
    wr_imports(c, p, first);
    wr_call(c, "thread_open_shared");
    emit(c, arm64.ldr_x(0, 31, 0));
    wr_imports(c, p, first);
    wr_call(c, "thread_wait_started");
    wr_current(c, p, first);
    wr_call(c, "gc_block_leave");

    // 编码句柄：(generation << 8) | (slot + 1)
    emit(c, arm64.ldr_x(10, 31, 0));
    wr_ctx(c, p, first, 9, 1);
    emit(c, arm64.sub_x(9, 10, 9));
    wr_num(c, 13, wr_stride);
    emit(c, arm64.udiv_x(9, 9, 13));
    emit(c, arm64.add_imm_x(11, 9, 1, iie));
    wr_num(c, 12, wr_generation);
    emit(c, arm64.add_x(12, 10, 12));
    emit(c, arm64.ldr_x(12, 12, 0));
    wr_num(c, 13, 256);
    emit(c, arm64.mul_x(12, 12, 13));
    emit(c, arm64.add_x(11, 11, 12));
    emit(c, arm64.str_x(11, 31, 176));
    emit(c, arm64.add_imm_x(31, 31, 32, iie));
    attached_restore(c);

    attached_save(c, "attached_worker_join");
    emit(c, arm64.sub_imm_x(31, 31, 32, iie));
    emit(c, arm64.ldr_x(9, 31, 176));
    wr_num(c, 13, 255);
    emit(c, arm64.and_x(13, 9, 13));
    emit(c, arm64.sub_imm_x(13, 13, 1, iie));
    emit(c, arm64.cmp_imm_x(13, worker_slots, iie));
    arm64.assembler_b_cond(c, 2, "worker_join_bad");
    wr_num(c, 14, 256);
    emit(c, arm64.udiv_x(14, 9, 14));
    move_x(c, 9, 13);
    wr_num(c, 13, wr_stride);
    emit(c, arm64.mul_x(9, 9, 13));
    wr_ctx(c, p, first, 10, 1);
    emit(c, arm64.add_x(10, 10, 9));

    arm64.assembler_label(c, "worker_join_ready");
    emit(c, arm64.ldr_x(11, 10, gc.thread_owns_handle));
    arm64.assembler_cbz_x(c, 11, "worker_join_bad");
    wr_num(c, 12, wr_generation);
    emit(c, arm64.add_x(12, 10, 12));
    emit(c, arm64.ldr_x(12, 12, 0));
    emit(c, arm64.cmp_x(12, 14));
    arm64.assembler_b_cond(c, 1, "worker_join_bad");

    emit(c, arm64.str_x(10, 31, 0));
    wr_current(c, p, first);
    wr_poll(c, p, first, "gc_block_enter");
    emit(c, arm64.ldr_x(0, 31, 0));
    wr_imports(c, p, first);
    wr_call(c, "thread_wait_completion");
    emit(c, arm64.ldr_x(0, 31, 0));
    wr_imports(c, p, first);
    wr_call(c, "thread_close");
    wr_current(c, p, first);
    wr_call(c, "gc_block_leave");

    wr_current(c, p, first);
    wr_num(c, 9, wr_join_status);
    emit(c, arm64.add_x(9, 0, 9));
    emit(c, arm64.movz_x(10, 0, 0));
    emit(c, arm64.str_x(10, 9, 0));
    emit(c, arm64.ldr_x(9, 31, 0));
    emit(c, arm64.ldr_x(9, 9, wr_result));
    emit(c, arm64.str_x(9, 31, 176));

    emit(c, arm64.ldr_x(9, 31, 0));
    wr_num(c, 15, wr_generation);
    emit(c, arm64.add_x(14, 9, 15));
    emit(c, arm64.ldr_x(10, 14, 0));
    emit(c, arm64.add_imm_x(10, 10, 1, iie));
    emit(c, arm64.str_x(10, 14, 0));
    wr_num(c, 15, wr_claim);
    emit(c, arm64.add_x(14, 9, 15));
    emit(c, arm64.movz_x(10, 0, 0));
    emit(c, arm64.stlr_x(10, 14));
    emit(c, arm64.add_imm_x(31, 31, 32, iie));
    attached_restore(c);

    // 非法句柄（从未分配、已 join、代际过期或伪造）：返回 -22 并在 join_status 中记录 22。
    arm64.assembler_label(c, "worker_join_bad");
    wr_current(c, p, first);
    wr_num(c, 9, wr_join_status);
    emit(c, arm64.add_x(9, 0, 9));
    wr_num(c, 10, 22);
    emit(c, arm64.str_x(10, 9, 0));
    wr_neg(c, 9, 22);
    emit(c, arm64.str_x(9, 31, 176));
    emit(c, arm64.add_imm_x(31, 31, 32, iie));
    attached_restore(c);

    attached_save(c, "attached_join_status");
    wr_current(c, p, first);
    wr_num(c, 10, wr_join_status);
    emit(c, arm64.add_x(10, 0, 10));
    emit(c, arm64.ldr_x(9, 10, 0));
    emit(c, arm64.str_x(9, 31, 144));
    attached_restore(c);

    attached_save(c, "attached_worker_wait");
    wr_poll(c, p, first, "gc_mutator_poll");
    wr_current(c, p, first);
    emit(c, arm64.ldr_x(1, 31, 144));
    arm64.assembler_bl(c, "attached_thread_wait");
    emit(c, arm64.str_x(0, 31, 144));
    attached_restore(c);

    attached_save(c, "attached_worker_collect");
    moshi (old_mark_proto_enabled(c)) {
        emit(c, arm64.ldr_x(9, 31, 144));
        emit(c, arm64.cmp_imm_x(9, 2, iie));
        arm64.assembler_b_cond(c, 3, "old_collect_legacy");
        arm64.assembler_bl(c, "old_collect_dispatch");
        emit(c, arm64.str_x(0, 31, 144));
        attached_restore(c);
        arm64.assembler_label(c, "old_collect_legacy");
    }
    moshi (old_sweep_enabled(c)) {
        emit(c, arm64.ldr_x(9, 31, 144));
        emit(c, arm64.cmp_imm_x(9, 1, iie));
        arm64.assembler_b_cond(c, 1, "worker_collect_not_major_request");
        arm64.assembler_bl(c, "old_cancel_requested");
        arm64.assembler_label(c, "worker_collect_not_major_request");
    }
    wr_poll(c, p, first, "gc_heap_enter");
    wr_current(c, p, first);
    move_x(c, 1, 23);
    wr_addr(c, 2, 0, wr_snapshot);
    emit(c, arm64.ldr_x(3, 31, 144));
    wr_call(c, "gc_collect_stopped");
    wr_current(c, p, first);
    move_x(c, 9, 0);
    wr_snapshot_trace(c, 9);
    wr_call(c, "gc_end");
    emit(c, arm64.ldr_x(9, 23, 304));
    emit(c, arm64.str_x(9, 31, 144));
    attached_restore(c);

    kaku native_names = ["attached_native_enter", "attached_native_leave"];
    i = 0;
    aida (i < 2) {
        attached_save(c, native_names[i]);
        emit(c, arm64.sub_imm_x(31, 31, 16, iie));
        emit(c, arm64.read_nzcv(9));
        emit(c, arm64.str_x(9, 31, 0));
        moshi (i == 0) {
            wr_current(c, p, first);
            wr_increment(c, 0, 8648);
            move_x(c, 1, 24);
            wr_call(c, "gc_block_enter");
        } sore {
            wr_current(c, p, first);
            wr_call(c, "gc_block_leave");
        }
        emit(c, arm64.ldr_x(9, 31, 0));
        emit(c, arm64.write_nzcv(9));
        emit(c, arm64.add_imm_x(31, 31, 16, iie));
        attached_restore(c);
        i = i + 1;
    }

    // 主线程退出前（仅证据测试模式）join 所有未回收的子线程，然后再删除 TLS Key。
    attached_save(c, "attached_workers_join_all");
    i = 1;
    aida (i <= worker_slots) {
        wr_ctx(c, p, first, 9, i);
        emit(c, arm64.ldr_x(10, 9, gc.thread_owns_handle));
        kaku done = string.concat("worker_shutdown_", convert.format_int(i));
        arm64.assembler_cbz_x(c, 10, done);
        wr_num(c, 0, i);
        arm64.assembler_bl(c, "attached_worker_join");
        arm64.assembler_label(c, done);
        i = i + 1;
    }
    attached_restore(c);

    attached_save(c, "attached_roots_close");
    // 公开线程模式：进程随主线程结束而结束，无论其他线程状态如何，不执行 join_all 或关闭操作。
    moshi (arm64.assembler_label_word(c, "worker_evidence") < 0) {
        attached_restore(c);
        attached_save(c, "attached_roots_close_test");
    }
    arm64.assembler_bl(c, "attached_workers_join_all");
    moshi (old_mark_proto_enabled(c)) { arm64.assembler_bl(c, "old_control_close"); }
    wr_current(c, p, first);
    wr_call(c, "thread_leave");
    wr_ctx(c, p, first, 0, 0);
    wr_imports(c, p, first);
    wr_call(c, "thread_close");

    // 仅在所有持有者与读取者退出后才输出运行时计数器。
    // 证据测试构建（存在 worker_evidence 标签）向 stderr 输出 360 字节二进制计数器记录；公开线程模式绝不输出。
    moshi (arm64.assembler_label_word(c, "worker_evidence") >= 0) {
        wr_ctx(c, p, first, 14, 0);
        wr_addr(c, 15, 14, wr_snapshot);
        i = 0;
        aida (i < 3) {
            wr_ctx(c, p, first, 9, i);
            kaku offsets = [
                gc.thread_registrations, gc.thread_exits, gc.thread_starts,
                gc.thread_joins, gc.thread_acquisitions, gc.thread_releases, 480
            ];
            kaku j = 0;
            aida (j < 7) {
                emit(c, arm64.ldr_x(10, 9, offsets[j]));
                emit(c, arm64.str_x(10, 15, (i * 7 + j) * 8));
                j = j + 1;
            }
            i = i + 1;
        }
        emit(c, arm64.ldr_x(10, 14, 448));
        emit(c, arm64.str_x(10, 15, 168));
        emit(c, arm64.ldr_x(10, 23, gc.minor_count));
        emit(c, arm64.str_x(10, 15, 176));
        emit(c, arm64.ldr_x(10, 23, gc.major_count));
        emit(c, arm64.str_x(10, 15, 184));
        emit(c, arm64.ldr_x(10, 23, gc.los_count));
        emit(c, arm64.str_x(10, 15, 192));
        emit(c, arm64.ldr_x(10, 23, gc.los_reclaimed));
        emit(c, arm64.str_x(10, 15, 200));
        emit(c, arm64.ldr_x(10, 23, 304));
        emit(c, arm64.str_x(10, 15, 208));

        i = 1;
        aida (i <= 2) {
            wr_ctx(c, p, first, 9, i);
            emit(c, arm64.ldr_x(10, 9, gc.thread_waits));
            emit(c, arm64.str_x(10, 15, 208 + i * 8));
            i = i + 1;
        }
        i = 0;
        aida (i < 3) {
            wr_ctx(c, p, first, 9, i);
            emit(c, arm64.ldr_x(10, 9, 8648));
            emit(c, arm64.str_x(10, 15, 232 + i * 8));
            i = i + 1;
        }
        i = 1;
        aida (i <= 2) {
            wr_ctx(c, p, first, 9, i);
            emit(c, arm64.ldr_x(10, 9, 8656));
            emit(c, arm64.str_x(10, 15, 240 + i * 16));
            emit(c, arm64.ldr_x(10, 9, 8664));
            emit(c, arm64.str_x(10, 15, 248 + i * 16));
            i = i + 1;
        }
        i = 0;
        aida (i < 3) {
            wr_ctx(c, p, first, 9, i);
            emit(c, arm64.ldr_x(10, 9, 8672));
            emit(c, arm64.str_x(10, 15, 288 + i * 16));
            emit(c, arm64.ldr_x(10, 9, 8680));
            emit(c, arm64.str_x(10, 15, 296 + i * 16));
            i = i + 1;
        }
        i = 0;
        aida (i < 3) {
            wr_ctx(c, p, first, 9, i);
            emit(c, arm64.ldr_x(10, 9, gc.thread_identity_value));
            emit(c, arm64.str_x(10, 15, 336 + i * 8));
            i = i + 1;
        }
        emit(c, arm64.movz_x(0, 2, 0));
        move_x(c, 1, 15);
        wr_num(c, 2, 360);
        wr_num(c, 16, 4);
        emit(c, arm64.svc(128));
        emit(c, arm64.cmp_imm_x(0, 360, iie));
        arm64.assembler_b_cond(c, 1, "runtime_error");
    }
    attached_restore(c);

    stw_bridge_enter(c, "worker_heap_collect");
    move_x(c, 23, 0);
    move_x(c, 24, 1);
    arm64.assembler_cbz_x(c, 2, "worker_minor");
    arm64.assembler_bl(c, "gen_major");
    arm64.assembler_b(c, "worker_collected");
    arm64.assembler_label(c, "worker_minor");
    arm64.assembler_bl(c, "gen_minor");
    arm64.assembler_label(c, "worker_collected");
    emit(c, arm64.movz_x(0, 0, 0));
    stw_bridge_leave(c);

    stw_bridge_enter(c, "worker_heap_alloc");
    move_x(c, 23, 0);
    move_x(c, 24, 1);
    move_x(c, 0, 2);
    move_x(c, 1, 3);
    arm64.assembler_bl(c, "runtime_alloc_legacy");
    stw_bridge_leave(c);

    stw_bridge_enter(c, "worker_posix_spawn");
    wr_imports(c, p, first);
    arm64.assembler_bl(c, "attached_platform_process_spawn");
    stw_bridge_leave(c);

    moshi (old_mark_proto_enabled(c)) { emit_old_mark_adapter(c, p, first, queue_slots); }
    moshi (old_sweep_enabled(c)) { emit_sweep_adapter(c, p, first); }

    kaku functions = gc.worker_thread_program(iie);
    array.append_all(functions, gc.safepoint_program(wr_snapshot_capacity));
    array.append_all(functions, gc.stopped_heap_program(wr_snapshot_capacity));
    array.append_all(functions, gc.mutator_program());
    array.append_all(functions, darwin.worker_platform_program());
    moshi (old_mark_proto_enabled(c)) {
        array.append_all(functions, gc.old_mark_program());
        functions = gc.old_heap_epoch_program(functions, 8704, wr_stride);
        moshi (old_sweep_enabled(c)) {
            functions = gc.concurrent_sweep_program(functions, 8704, wr_stride);
        }
    }

    kaku bindings = darwin.worker_bindings();
    array.push(bindings, ir.Binding { operation: gc.gc_visit_root_operation, slot: 25, arguments: [0, 1, 2], result_bits: 64 });
    array.push(bindings, ir.Binding { operation: gc.gc_collect_stopped_operation, slot: 26, arguments: [0, 1, 2], result_bits: 64 });
    array.push(bindings, ir.Binding { operation: gc.gc_allocate_stopped_operation, slot: 27, arguments: [0, 1, 2, 3], result_bits: 64 });
    moshi (old_sweep_enabled(c)) {
        array.push(bindings, ir.Binding { operation: gc.sweep_account_operation, slot: 28, arguments: [0], result_bits: 64 });
        array.push(bindings, ir.Binding { operation: gc.sweep_unmap_operation, slot: 29, arguments: [0, 1], result_bits: 64 });
    }

    emit_word_natives(c, p, first);
    kaku error = aarch64.emit_program(c, functions, bindings, worker_import_slots(c), "attached");
    moshi (error != "") { kaesu error; }

    i = 0;
    aida (i < len(callbacks)) {
        kaku target = arm64.assembler_label_word(c, callbacks[i]);
        kaku ins = arm64.adr(9, (target - relocations[i]) * 4);
        moshi (ins.error != mu) { kaesu "WORKER_CALLBACK_RANGE"; }
        c.words[relocations[i]] = ins.word;
        i = i + 1;
    }

    kaku target = arm64.assembler_label_word(c, "worker_user_entry");
    kaku entry = arm64.adr(9, (target - worker_address) * 4);
    moshi (entry.error != mu) { kaesu "WORKER_ENTRY_RANGE"; }
    c.words[worker_address] = entry.word;
    kaesu "";
}
