yobu "kiso/aot/lower/types";
yobu "kiso/aot/pe";
yobu "kiso/aot/x86_64";
yobu "kiso/array";
yobu "kiso/convert";
yobu "kiso/encoding/mochi";
yobu "kiso/string";

// Pure Mio Mochi -> Windows AMD64 PE32+ lowering, scalar subset (no heap, no GC).
//
// Internal execution model (private to this backend, shared with kiso/aot/lowerlinux): the Mochi operand stack is the
// native stack; each function has an rbp frame, arguments are pushed by the caller and popped by the caller.
// The Win64 ABI applies at the Windows API boundary only (rt.write / rt.exit): RSP is realigned to 16 bytes, 32 bytes of
// shadow space are reserved, the fifth argument has its own slot and only volatile registers carry values across calls.
// Every emitted function (program functions, entry, runtime routines) is a frame-pointer function with matching
// RUNTIME_FUNCTION / UNWIND_INFO: push rbp; mov rbp,rsp; [sub rsp,N]; epilogue = lea rsp,[rbp]; pop rbp; ret.
// Anything outside the supported subset is a compile error: nothing is ignored and there is no VM fallback.
koukai kata LowerResult { bytes: []uint8; error: string; }

koukai teisu io_failure_exit = 111;
waza failed(message: string) -> LowerResult { kaesu LowerResult { bytes: [], error: message }; }

waza block_label(prefix: string, offset: int64) -> string {
    kaesu string.concat(prefix, string.concat(".", convert.format_int(offset)));
}
waza function_label(id: int64) -> string { kaesu string.concat("fn.", convert.format_int(id)); }
waza string_label(index: int64) -> string { kaesu string.concat("str.", convert.format_int(index)); }
waza operand_u16(data: []uint8, offset: int64) -> int64 {
    kaesu int64(data[offset + 1]) * 256 + int64(data[offset + 2]);
}

waza constant_value(constant: mochi.Constant) -> int64 {
    kaku high = int64(constant.bits.high);
    kaku low = int64(constant.bits.low);
    kaku tag = int64(constant.tag);
    moshi (tag == 5) { moshi (low >= 128) { kaesu low - 256; } kaesu low; }
    moshi (tag == 6) { moshi (low >= 32768) { kaesu low - 65536; } kaesu low; }
    moshi (tag == 7) { moshi (low >= 2147483648) { kaesu low - 4294967296; } kaesu low; }
    moshi (tag >= 8) { kaesu low; }
    moshi (high >= 2147483648) { high = high - 4294967296; }
    kaesu high * 4294967296 + low;
}

waza local_disp(parameters: int64, index: int64) -> int64 {
    moshi (index < parameters) { kaesu 16 + 8 * (parameters - 1 - index); }
    kaesu -8 * (index - parameters + 1);
}

// ---- frames -------------------------------------------------------------------------------------------------------

// Emits label, `push rbp`, `mov rbp,rsp` and optionally `sub rsp,alloc`; returns the start offset.
waza open_frame(code: x86_64.Assembler, name: string, alloc: int64) -> int64 {
    x86_64.label(code, name);
    kaku begin = len(code.bytes);
    x86_64.push_r(code, x86_64.rbp);
    x86_64.mov_rr(code, x86_64.rbp, x86_64.rsp);
    moshi (alloc > 0) { x86_64.sub_ri(code, x86_64.rsp, alloc); }
    kaesu begin;
}

// Prologue byte layout is fixed by the encoder: push rbp = 1, mov rbp,rsp = 3, sub rsp,imm32 = 7.
waza close_frame(code: x86_64.Assembler, frames: []pe.FrameFunction, begin: int64, alloc: int64) -> unit {
    kaku alloc_offset = 0;
    moshi (alloc > 0) { alloc_offset = 11; }
    array.push(frames, pe.FrameFunction { begin: begin, end: len(code.bytes), push_offset: 1, set_offset: 4,
        alloc_offset: alloc_offset, alloc_size: alloc });
}

waza emit_epilogue(code: x86_64.Assembler) -> unit {
    x86_64.lea(code, x86_64.rsp, x86_64.rbp, 0);
    x86_64.pop_r(code, x86_64.rbp);
    x86_64.ret(code);
}

// mov r11, <IAT slot VA> ; call [r11]. The VA is patched by the PE writer and registered as a DIR64 relocation.
waza import_call(code: x86_64.Assembler, patches: []pe.Patch, index: int64) -> unit {
    kaku at = len(code.bytes);
    x86_64.mov_ri(code, x86_64.r11, 0);
    array.push(patches, pe.Patch { section: pe.text_section, offset: at + 2, kind: pe.va64, target: pe.import_section, target_offset: index });
    x86_64.call_memory(code, x86_64.r11, 0);
}

// Address of the 64-bit global slot in rcx.
waza global_address(code: x86_64.Assembler, patches: []pe.Patch, slot: int64) -> unit {
    kaku at = len(code.bytes);
    x86_64.mov_ri(code, x86_64.rcx, 0);
    array.push(patches, pe.Patch { section: pe.text_section, offset: at + 2, kind: pe.va64, target: pe.data_section, target_offset: slot * 8 });
}

// ---- runtime routines (Win64 boundary) -----------------------------------------------------------------------------

// rt.exit: rcx = status. Never returns.
waza emit_exit(code: x86_64.Assembler, patches: []pe.Patch, frames: []pe.FrameFunction) -> unit {
    kaku begin = open_frame(code, "rt.exit", 0);
    x86_64.and_ri(code, x86_64.rsp, -16);
    x86_64.sub_ri(code, x86_64.rsp, 32);
    import_call(code, patches, 2);
    emit_epilogue(code);
    close_frame(code, frames, begin, 0);
}

// rt.write: rcx = fd (1 or 2), rdx = pointer, r8 = length. Writes all bytes to the inherited synchronous handle.
// Any GetStdHandle / WriteFile failure, zero progress or oversized count exits with 111 (never succeeds silently).
// Frame after realignment: [0,32) shadow, +32 fifth argument, +40 bytes written, +48 handle, +56 cursor, +64 remaining.
waza emit_write(code: x86_64.Assembler, patches: []pe.Patch, frames: []pe.FrameFunction) -> unit {
    kaku begin = open_frame(code, "rt.write", 0);
    x86_64.and_ri(code, x86_64.rsp, -16);
    x86_64.sub_ri(code, x86_64.rsp, 80);
    x86_64.mov_store(code, x86_64.rsp, 56, x86_64.rdx);
    x86_64.mov_store(code, x86_64.rsp, 64, x86_64.r8);
    x86_64.cmp_ri(code, x86_64.rcx, 1);
    x86_64.mov_ri(code, x86_64.rcx, 4294967285);
    x86_64.jcc(code, x86_64.cc_e, "rt.write.handle");
    x86_64.mov_ri(code, x86_64.rcx, 4294967284);
    x86_64.label(code, "rt.write.handle");
    import_call(code, patches, 0);
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_e, "rt.write.failure");
    x86_64.cmp_ri(code, x86_64.rax, -1);
    x86_64.jcc(code, x86_64.cc_e, "rt.write.failure");
    x86_64.mov_store(code, x86_64.rsp, 48, x86_64.rax);
    x86_64.label(code, "rt.write.again");
    x86_64.mov_load(code, x86_64.r8, x86_64.rsp, 64);
    x86_64.test_rr(code, x86_64.r8, x86_64.r8);
    x86_64.jcc(code, x86_64.cc_e, "rt.write.done");
    x86_64.mov_load(code, x86_64.rcx, x86_64.rsp, 48);
    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 56);
    x86_64.lea(code, x86_64.r9, x86_64.rsp, 40);
    x86_64.mov_ri(code, x86_64.rax, 0);
    x86_64.mov_store(code, x86_64.rsp, 40, x86_64.rax);
    x86_64.mov_store(code, x86_64.rsp, 32, x86_64.rax);
    import_call(code, patches, 1);
    x86_64.zero_extend_eax(code);
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_e, "rt.write.failure");
    x86_64.mov_load(code, x86_64.rax, x86_64.rsp, 40);
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_e, "rt.write.failure");
    x86_64.mov_load(code, x86_64.r8, x86_64.rsp, 64);
    x86_64.cmp_rr(code, x86_64.rax, x86_64.r8);
    x86_64.jcc(code, x86_64.cc_a, "rt.write.failure");
    x86_64.sub_rr(code, x86_64.r8, x86_64.rax);
    x86_64.mov_store(code, x86_64.rsp, 64, x86_64.r8);
    x86_64.mov_load(code, x86_64.rdx, x86_64.rsp, 56);
    x86_64.add_rr(code, x86_64.rdx, x86_64.rax);
    x86_64.mov_store(code, x86_64.rsp, 56, x86_64.rdx);
    x86_64.jmp(code, "rt.write.again");
    x86_64.label(code, "rt.write.done");
    emit_epilogue(code);
    x86_64.label(code, "rt.write.failure");
    x86_64.mov_ri(code, x86_64.rcx, io_failure_exit);
    x86_64.call(code, "rt.exit");
    close_frame(code, frames, begin, 0);
}

// rt.print_int: value in rax; decimal text and "\n" to stdout.
waza emit_print_int(code: x86_64.Assembler, frames: []pe.FrameFunction) -> unit {
    kaku begin = open_frame(code, "rt.print_int", 64);
    x86_64.mov_ri(code, x86_64.r9, 0);
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_ge, "rt.print_int.positive");
    x86_64.neg_r(code, x86_64.rax);
    x86_64.mov_ri(code, x86_64.r9, 1);
    x86_64.label(code, "rt.print_int.positive");
    x86_64.lea(code, x86_64.rsi, x86_64.rbp, -1);
    x86_64.mov_ri(code, x86_64.rdx, 10);
    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);
    x86_64.mov_ri(code, x86_64.r8, 10);
    x86_64.label(code, "rt.print_int.digit");
    x86_64.mov_ri(code, x86_64.rdx, 0);
    x86_64.div_r(code, x86_64.r8);
    x86_64.add_ri(code, x86_64.rdx, 48);
    x86_64.sub_ri(code, x86_64.rsi, 1);
    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_ne, "rt.print_int.digit");
    x86_64.test_rr(code, x86_64.r9, x86_64.r9);
    x86_64.jcc(code, x86_64.cc_e, "rt.print_int.write");
    x86_64.mov_ri(code, x86_64.rdx, 45);
    x86_64.sub_ri(code, x86_64.rsi, 1);
    x86_64.mov_store8(code, x86_64.rsi, 0, x86_64.rdx);
    x86_64.label(code, "rt.print_int.write");
    x86_64.lea(code, x86_64.r8, x86_64.rbp, 0);
    x86_64.sub_rr(code, x86_64.r8, x86_64.rsi);
    x86_64.mov_rr(code, x86_64.rdx, x86_64.rsi);
    x86_64.mov_ri(code, x86_64.rcx, 1);
    x86_64.call(code, "rt.write");
    emit_epilogue(code);
    close_frame(code, frames, begin, 64);
}

// rt.write_text: rdx = label address, r8 = length -> stdout.
waza emit_write_literal(code: x86_64.Assembler, label: string, length: int64, fd: int64) -> unit {
    x86_64.lea_label(code, x86_64.rdx, label);
    x86_64.mov_ri(code, x86_64.r8, length);
    x86_64.mov_ri(code, x86_64.rcx, fd);
    x86_64.call(code, "rt.write");
}

waza emit_print_bool(code: x86_64.Assembler, frames: []pe.FrameFunction) -> unit {
    kaku begin = open_frame(code, "rt.print_bool", 0);
    x86_64.test_rr(code, x86_64.rax, x86_64.rax);
    x86_64.jcc(code, x86_64.cc_e, "rt.print_bool.false");
    emit_write_literal(code, "rt.text.true", 4, 1);
    emit_epilogue(code);
    x86_64.label(code, "rt.print_bool.false");
    emit_write_literal(code, "rt.text.false", 4, 1);
    emit_epilogue(code);
    close_frame(code, frames, begin, 0);
}

// rt.print_string: rax = string object (header 16, length at 16, bytes at 24) -> text and "\n" on stdout.
waza emit_print_string(code: x86_64.Assembler, frames: []pe.FrameFunction) -> unit {
    kaku begin = open_frame(code, "rt.print_string", 0);
    x86_64.mov_load(code, x86_64.r8, x86_64.rax, 16);
    x86_64.lea(code, x86_64.rdx, x86_64.rax, 24);
    x86_64.mov_ri(code, x86_64.rcx, 1);
    x86_64.call(code, "rt.write");
    emit_write_literal(code, "rt.text.newline", 1, 1);
    emit_epilogue(code);
    close_frame(code, frames, begin, 0);
}

waza emit_trap(code: x86_64.Assembler, frames: []pe.FrameFunction, label: string, text: string, length: int64) -> unit {
    kaku begin = open_frame(code, label, 0);
    emit_write_literal(code, text, length, 2);
    x86_64.mov_ri(code, x86_64.rcx, 1);
    x86_64.call(code, "rt.exit");
    emit_epilogue(code);
    close_frame(code, frames, begin, 0);
}

waza data_string(code: x86_64.Assembler, label: string, text: string) -> unit {
    x86_64.label(code, label);
    kaku bytes = string.to_bytes(text);
    kaku at = 0;
    aida (at < len(bytes)) { x86_64.byte(code, int64(bytes[at])); at = at + 1; }
}

waza emit_runtime(code: x86_64.Assembler, patches: []pe.Patch, frames: []pe.FrameFunction) -> unit {
    emit_exit(code, patches, frames);
    emit_write(code, patches, frames);
    emit_print_int(code, frames);
    emit_print_bool(code, frames);
    emit_print_string(code, frames);
    emit_trap(code, frames, "rt.trap.divide", "rt.text.divide", 32);
    emit_trap(code, frames, "rt.trap.unreachable", "rt.text.unreachable", 35);
    data_string(code, "rt.text.true", "hai\n");
    data_string(code, "rt.text.false", "iie\n");
    data_string(code, "rt.text.newline", "\n");
    data_string(code, "rt.text.divide", "runtime error: division by zero\n");
    data_string(code, "rt.text.unreachable", "runtime error: unreachable code\n");
}

waza emit_word(code: x86_64.Assembler, value: int64) -> unit {
    kaku rest = value;
    kaku at = 0;
    aida (at < 8) { x86_64.byte(code, rest - (rest / 256) * 256); rest = rest / 256; at = at + 1; }
}

// Constant strings are immutable string objects in .text (kind 6 | size << 8, gc word, length, bytes); no heap, no GC.
waza emit_string_constants(code: x86_64.Assembler, file: mochi.File) -> unit {
    kaku index = 0;
    aida (index < len(file.constants)) {
        kaku constant = file.constants[index];
        moshi (int64(constant.tag) == 2) {
            x86_64.label(code, string_label(index));
            emit_word(code, 6 + 256 * (24 + len(constant.data)));
            emit_word(code, 0);
            emit_word(code, len(constant.data));
            kaku at = 0;
            aida (at < len(constant.data)) { x86_64.byte(code, int64(constant.data[at])); at = at + 1; }
        }
        index = index + 1;
    }
}

// ---- instruction selection ------------------------------------------------------------------------------------------

waza condition_for(opcode: int64) -> int64 {
    moshi (opcode == 11) { kaesu x86_64.cc_e; }
    moshi (opcode == 12) { kaesu x86_64.cc_ne; }
    moshi (opcode == 13) { kaesu x86_64.cc_l; }
    moshi (opcode == 14) { kaesu x86_64.cc_le; }
    moshi (opcode == 15) { kaesu x86_64.cc_g; }
    kaesu x86_64.cc_ge;
}

waza supported(opcode: int64) -> bool {
    kaesu (opcode >= 1 && opcode <= 20) || opcode == 22 || opcode == 23 || opcode == 24 || opcode == 25 || opcode == 26 || opcode == 27 || opcode == 49;
}

waza stack_node(analysis: types.TypeAnalysis, function_id: int64, offset: int64, depth: int64) -> int64 {
    kaku entries = analysis.blocks[function_id + 1].entry[offset];
    moshi (depth >= len(entries)) { kaesu -1; }
    kaesu entries[len(entries) - 1 - depth];
}

// Integer/bool values are raw 64-bit slots. Nullable values would be boxed objects and floats need SSE: both are rejected.
waza scalar_operand(analysis: types.TypeAnalysis, node: int64, allow_bool: bool) -> string {
    moshi (node < 0) { kaesu "MISSING_TYPE_INFO"; }
    kaku kind = types.type_kind(analysis, node);
    moshi (types.type_nullable(analysis, node)) { kaesu "UNSUPPORTED_NULLABLE"; }
    moshi (kind == types.type_integer) { kaesu ""; }
    moshi (kind == types.type_bool && allow_bool) { kaesu ""; }
    kaesu string.concat("UNSUPPORTED_OPERAND_TYPE ", convert.format_int(kind));
}

waza emit_normalize(code: x86_64.Assembler, descriptor: int64) -> unit {
    moshi (descriptor < 12 || descriptor > 17) { kaesu; }
    kaku width = 8;
    moshi (descriptor == 13 || descriptor == 16) { width = 16; }
    moshi (descriptor == 14 || descriptor == 17) { width = 32; }
    x86_64.shl_ri(code, x86_64.rax, 64 - width);
    moshi (descriptor <= 14) { x86_64.sar_ri(code, x86_64.rax, 64 - width); }
    moshi (descriptor > 14) { x86_64.shr_ri(code, x86_64.rax, 64 - width); }
}

// "$mma::mio/os/runtime::exit:..." -> "exit"; "" for every other body-less function.
waza native_exit(name: string) -> bool {
    kaku prefix = "$mma::mio/os/runtime::exit";
    moshi (!string.has_prefix(name, prefix)) { kaesu iie; }
    kaku bytes = string.to_bytes(name);
    kaku at = string.byte_len(prefix);
    kaesu at == len(bytes) || bytes[at] == uint8(58);
}

waza emit_block(code: x86_64.Assembler, patches: []pe.Patch, file: mochi.File, analysis: types.TypeAnalysis, data: []uint8,
    prefix: string, function_id: int64, parameters: int64) -> string {
    kaku offset = 0;
    aida (offset < len(data)) {
        x86_64.label(code, block_label(prefix, offset));
        kaku opcode = int64(data[offset]);
        moshi (!supported(opcode)) { kaesu string.concat("UNSUPPORTED_OPCODE ", convert.format_int(opcode)); }
        kaku step = types.type_instruction_width(opcode);
        moshi (step == 0) { kaesu string.concat("UNSUPPORTED_OPCODE ", convert.format_int(opcode)); }
        moshi (offset + step > len(data)) { kaesu "TRUNCATED_INSTRUCTION"; }
        kaku operand = 0;
        moshi (step >= 3) { operand = operand_u16(data, offset); }
        moshi (offset >= len(analysis.blocks[function_id + 1].entry)) { kaesu "MISSING_TYPE_INFO"; }
        moshi (opcode == 1) {
            moshi (operand >= len(file.constants)) { kaesu "INVALID_CONSTANT_INDEX"; }
            kaku constant = file.constants[operand];
            kaku tag = int64(constant.tag);
            moshi (tag == 2) { x86_64.lea_label(code, x86_64.rax, string_label(operand)); }
            moshi (tag == 1 || (tag >= 5 && tag <= 10)) { x86_64.mov_ri(code, x86_64.rax, constant_value(constant)); }
            moshi (tag != 1 && tag != 2 && !(tag >= 5 && tag <= 10)) { kaesu string.concat("UNSUPPORTED_CONSTANT_TAG ", convert.format_int(tag)); }
            x86_64.push_r(code, x86_64.rax);
        }
        moshi (opcode == 2 || opcode == 4 || opcode == 5 || opcode == 6) {
            kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 0), iie);
            moshi (bad == "") { bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 1), iie); }
            moshi (bad != "") { kaesu bad; }
            x86_64.pop_r(code, x86_64.rcx); x86_64.pop_r(code, x86_64.rax);
            moshi (opcode == 2) { x86_64.add_rr(code, x86_64.rax, x86_64.rcx); }
            moshi (opcode == 4) { x86_64.sub_rr(code, x86_64.rax, x86_64.rcx); }
            moshi (opcode == 5) { x86_64.imul_rr(code, x86_64.rax, x86_64.rcx); }
            moshi (opcode == 6) {
                kaku done = block_label(string.concat(prefix, ".div"), offset);
                kaku wrapped = block_label(string.concat(prefix, ".neg"), offset);
                x86_64.test_rr(code, x86_64.rcx, x86_64.rcx);
                x86_64.jcc(code, x86_64.cc_e, "rt.trap.divide");
                x86_64.mov_ri(code, x86_64.rdx, -1);
                x86_64.cmp_rr(code, x86_64.rcx, x86_64.rdx);
                x86_64.jcc(code, x86_64.cc_e, wrapped);
                x86_64.cqo(code);
                x86_64.idiv_r(code, x86_64.rcx);
                x86_64.jmp(code, done);
                x86_64.label(code, wrapped);
                x86_64.neg_r(code, x86_64.rax);
                x86_64.label(code, done);
            }
            emit_normalize(code, types.integer_descriptor(analysis, stack_node(analysis, function_id, offset, 0)));
            x86_64.push_r(code, x86_64.rax);
        }
        moshi (opcode == 3) { x86_64.pop_r(code, x86_64.rax); }
        moshi (opcode == 7) {
            kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 0), iie);
            moshi (bad != "") { kaesu bad; }
            x86_64.pop_r(code, x86_64.rax); x86_64.neg_r(code, x86_64.rax);
            emit_normalize(code, types.integer_descriptor(analysis, stack_node(analysis, function_id, offset, 0)));
            x86_64.push_r(code, x86_64.rax);
        }
        moshi (opcode == 8 || opcode == 9) {
            x86_64.mov_ri(code, x86_64.rax, 9 - opcode);
            x86_64.push_r(code, x86_64.rax);
        }
        moshi (opcode == 10) {
            kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 0), hai);
            moshi (bad != "") { kaesu bad; }
            x86_64.pop_r(code, x86_64.rax); x86_64.mov_ri(code, x86_64.rcx, 1); x86_64.xor_rr(code, x86_64.rax, x86_64.rcx);
            x86_64.push_r(code, x86_64.rax);
        }
        moshi (opcode >= 11 && opcode <= 16) {
            kaku equality = opcode <= 12;
            kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 0), equality);
            moshi (bad == "") { bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 1), equality); }
            moshi (bad != "") { kaesu bad; }
            x86_64.pop_r(code, x86_64.rcx); x86_64.pop_r(code, x86_64.rax);
            x86_64.cmp_rr(code, x86_64.rax, x86_64.rcx);
            x86_64.setcc_rax(code, condition_for(opcode));
            x86_64.push_r(code, x86_64.rax);
        }
        moshi (opcode == 17) { x86_64.jmp(code, block_label(prefix, operand)); }
        moshi (opcode == 18) {
            kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, 0), hai);
            moshi (bad != "") { kaesu bad; }
            x86_64.pop_r(code, x86_64.rax); x86_64.test_rr(code, x86_64.rax, x86_64.rax);
            x86_64.jcc(code, x86_64.cc_e, block_label(prefix, operand));
        }
        moshi (opcode == 19 || opcode == 20) {
            moshi (operand >= file.global_count) { kaesu "INVALID_GLOBAL_INDEX"; }
            kaku node = analysis.globals[operand];
            moshi (node < 0) { kaesu "MISSING_TYPE_INFO"; }
            moshi (types.type_nullable(analysis, node)) { kaesu "UNSUPPORTED_NULLABLE"; }
            kaku kind = types.type_kind(analysis, node);
            moshi (kind != types.type_integer && kind != types.type_bool && kind != types.type_string_id) { kaesu string.concat("UNSUPPORTED_GLOBAL_TYPE ", convert.format_int(kind)); }
            global_address(code, patches, operand);
            moshi (opcode == 19) { x86_64.pop_r(code, x86_64.rax); x86_64.mov_store(code, x86_64.rcx, 0, x86_64.rax); }
            moshi (opcode == 20) { x86_64.mov_load(code, x86_64.rax, x86_64.rcx, 0); x86_64.push_r(code, x86_64.rax); }
        }
        moshi (opcode == 22) {
            kaku node = stack_node(analysis, function_id, offset, 0);
            moshi (node < 0) { kaesu "MISSING_TYPE_INFO"; }
            kaku kind = types.type_kind(analysis, node);
            moshi (types.type_nullable(analysis, node) || (kind != types.type_integer && kind != types.type_bool && kind != types.type_string_id)) {
                kaesu string.concat("UNSUPPORTED_CHANT_TYPE ", convert.format_int(kind));
            }
            x86_64.pop_r(code, x86_64.rax);
            moshi (kind == types.type_integer) { x86_64.call(code, "rt.print_int"); }
            moshi (kind == types.type_bool) { x86_64.call(code, "rt.print_bool"); }
            moshi (kind == types.type_string_id) { x86_64.call(code, "rt.print_string"); }
        }
        moshi (opcode == 23 || opcode == 24 || opcode == 49) {
            moshi (function_id < 0) { kaesu "LOCAL_OUTSIDE_FUNCTION"; }
            moshi (operand >= file.functions[function_id].local_count) { kaesu "INVALID_LOCAL_INDEX"; }
            kaku node = analysis.locals[function_id][operand];
            moshi (node < 0) { kaesu "MISSING_TYPE_INFO"; }
            moshi (types.type_nullable(analysis, node)) { kaesu "UNSUPPORTED_NULLABLE"; }
            kaku kind = types.type_kind(analysis, node);
            moshi (kind != types.type_integer && kind != types.type_bool && kind != types.type_string_id) { kaesu string.concat("UNSUPPORTED_LOCAL_TYPE ", convert.format_int(kind)); }
            kaku disp = local_disp(parameters, operand);
            moshi (opcode == 24) { x86_64.mov_load(code, x86_64.rax, x86_64.rbp, disp); x86_64.push_r(code, x86_64.rax); }
            moshi (opcode != 24) { x86_64.pop_r(code, x86_64.rax); x86_64.mov_store(code, x86_64.rbp, disp, x86_64.rax); }
        }
        moshi (opcode == 25) {
            moshi (operand >= len(file.functions)) { kaesu "INVALID_FUNCTION_INDEX"; }
            kaku callee = file.functions[operand];
            kaku argument = 0;
            aida (argument < callee.parameter_count) {
                kaku bad = scalar_operand(analysis, stack_node(analysis, function_id, offset, argument), hai);
                moshi (bad != "" && types.type_kind(analysis, stack_node(analysis, function_id, offset, argument)) != types.type_string_id) { kaesu bad; }
                argument = argument + 1;
            }
            x86_64.call(code, function_label(operand));
            moshi (callee.parameter_count > 0) { x86_64.add_ri(code, x86_64.rsp, 8 * callee.parameter_count); }
            moshi (callee.returns_value) { x86_64.push_r(code, x86_64.rax); }
        }
        moshi (opcode == 26 || opcode == 27) {
            moshi (function_id < 0) { kaesu "RETURN_OUTSIDE_FUNCTION"; }
            moshi (opcode == 27) { x86_64.pop_r(code, x86_64.rax); }
            emit_epilogue(code);
        }
        offset = offset + step;
    }
    x86_64.label(code, block_label(prefix, offset));
    kaesu "";
}

waza emit_function(code: x86_64.Assembler, patches: []pe.Patch, frames: []pe.FrameFunction, file: mochi.File,
    analysis: types.TypeAnalysis, index: int64, reachable: bool) -> string {
    kaku function = file.functions[index];
    moshi (!reachable) {
        kaku begin = open_frame(code, function_label(index), 0);
        x86_64.call(code, "rt.trap.unreachable");
        emit_epilogue(code);
        close_frame(code, frames, begin, 0);
        kaesu "";
    }
    moshi (len(function.captures) != 0) { kaesu string.concat(function.name, ": UNSUPPORTED_CLOSURE"); }
    moshi (len(function.instructions) == 0) {
        moshi (!native_exit(function.name) || function.parameter_count != 1 || function.returns_value) {
            kaesu string.concat("UNSUPPORTED_NATIVE_FUNCTION ", function.name);
        }
        kaku begin = open_frame(code, function_label(index), 0);
        x86_64.mov_load(code, x86_64.rcx, x86_64.rbp, local_disp(1, 0));
        x86_64.call(code, "rt.exit");
        emit_epilogue(code);
        close_frame(code, frames, begin, 0);
        kaesu "";
    }
    kaku locals = function.local_count - function.parameter_count;
    moshi (locals < 0) { kaesu "INVALID_LOCAL_COUNT"; }
    kaku cell = 0;
    aida (cell < len(analysis.cells[index])) {
        moshi (analysis.cells[index][cell]) { kaesu string.concat(function.name, ": UNSUPPORTED_CAPTURED_LOCAL"); }
        cell = cell + 1;
    }
    kaku alloc = 8 * locals;
    kaku begin = open_frame(code, function_label(index), alloc);
    moshi (locals > 0) {
        x86_64.mov_ri(code, x86_64.rax, 0);
        kaku slot = 0;
        aida (slot < locals) { x86_64.mov_store(code, x86_64.rbp, -8 * (slot + 1), x86_64.rax); slot = slot + 1; }
    }
    kaku body = emit_block(code, patches, file, analysis, function.instructions, string.concat("f", convert.format_int(index)), index, function.parameter_count);
    moshi (body != "") { kaesu string.concat(function.name, string.concat(": ", body)); }
    emit_epilogue(code);
    close_frame(code, frames, begin, alloc);
    kaesu "";
}

koukai waza compile(file: mochi.File) -> LowerResult {
    kaku analysis = types.analyze_types(file);
    kaku code = x86_64.assembler();
    kaku patches: []pe.Patch = [];
    kaku frames: []pe.FrameFunction = [];
    // Entry (PE AddressOfEntryPoint = 0): the loader enters with RSP = 8 mod 16; the program body is a framed function.
    kaku begin = open_frame(code, "start", 0);
    kaku problem = emit_block(code, patches, file, analysis, file.instructions, "main", -1, 0);
    moshi (problem != "") { kaesu failed(string.concat("main: ", problem)); }
    x86_64.mov_ri(code, x86_64.rcx, 0);
    x86_64.call(code, "rt.exit");
    emit_epilogue(code);
    close_frame(code, frames, begin, 0);
    kaku reached = types.reachable_functions(file);
    kaku index = 0;
    aida (index < len(file.functions)) {
        kaku failure = emit_function(code, patches, frames, file, analysis, index, reached[index]);
        moshi (failure != "") { kaesu failed(failure); }
        index = index + 1;
    }
    emit_runtime(code, patches, frames);
    emit_string_constants(code, file);
    kaku assembled = x86_64.assemble(code);
    moshi (assembled.error != "") { kaesu failed(assembled.error); }
    kaku image = pe.executable_framed(pe.ImageSpec { text: assembled.bytes, rdata: [], data: [], zero_fill: 8 * file.global_count, entry: 0,
        imports: [pe.ImportLibrary { name: "KERNEL32.dll", symbols: ["GetStdHandle", "WriteFile", "ExitProcess"] }],
        patches: patches, unwind: [] }, frames);
    moshi (image.error != mu) { kaesu failed("PE_IMAGE_ERROR"); }
    kaesu LowerResult { bytes: image.bytes, error: "" };
}
