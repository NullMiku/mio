+++ b/examples/tcp_echo_client.mio
@@ -0,0 +1,27 @@
+yobu "kiso/net/tcp";
+yobu "kiso/io";
+
+waza send_and_receive(connection: tcp.Connection?) -> unit {
+    moshi (connection == mu) { kaesu; }
+    kaku data: []uint8 = [uint8(77), uint8(105), uint8(111)];
+    kaku sent = tcp.write_all(connection, data, 0, len(data));
+    kaku sent_error = sent.error;
+    chant(sent.count);
+    chant(sent_error == mu);
+
+    kaku echo: []uint8 = [0, 0, 0];
+    kaku received = io.read_full(tcp.reader(connection), echo, 0, len(echo));
+    kaku read_error = received.error;
+    chant(received.count);
+    chant(read_error == mu);
+    chant(echo[0]);
+    chant(echo[1]);
+    chant(echo[2]);
+
+    kaku closed = tcp.close(connection);
+}
+
+kaku address = tcp.ipv4(uint8(127), uint8(0), uint8(0), uint8(1), 18080);
+kaku connected = tcp.connect(address);
+chant(connected.error == mu);
+send_and_receive(connected.connection);
diff --git a/examples/tcp_echo_server.mio b/examples/tcp_echo_server.mio
new file mode 100644
index 0000000..ee1cdf0
--- /dev/null
+++ b/examples/tcp_echo_server.mio
@@ -0,0 +1,28 @@
+yobu "kiso/array";
+yobu "kiso/net/tcp";
+
+// Minimal single-client echo server. Run before tcp_echo_client.mio.
+waza serve_client(connection: tcp.Connection?) -> unit {
+    moshi (connection == mu) { kaesu; }
+    kaku data = array.make[uint8](1024, uint8(0));
+    kaku received = tcp.read(connection, data, 0, len(data));
+    kaku failure = received.error;
+    moshi (failure == mu && received.count > 0) {
+        kaku sent = tcp.write_all(connection, data, 0, received.count);
+        chant(sent.count);
+    }
+    kaku closed = tcp.close(connection);
+}
+
+waza serve(listener: tcp.Listener?) -> unit {
+    moshi (listener == mu) { kaesu; }
+    chant("Mio TCP server waiting on 127.0.0.1:18080");
+    kaku accepted = tcp.accept(listener);
+    serve_client(accepted.connection);
+    kaku stopped = tcp.close_listener(listener);
+}
+
+kaku address = tcp.ipv4(uint8(127), uint8(0), uint8(0), uint8(1), 18080);
+kaku started = tcp.listen(address);
+chant(started.error == mu);
+serve(started.listener);
diff --git a/internal/aot/bootstrapaudit/audit.go b/internal/aot/bootstrapaudit/audit.go
index 78adb75..1721858 100644
--- a/internal/aot/bootstrapaudit/audit.go
+++ b/internal/aot/bootstrapaudit/audit.go
@@ -79,6 +79,19 @@ type StructuralIssue struct {
 }
 
 func nativeFSSupported(name string) bool {
+	const socketPrefix = "$mma::mio/sys/socket::"
+	if strings.HasPrefix(name, socketPrefix) {
+		rest := strings.TrimPrefix(name, socketPrefix)
+		op, _, ok := strings.Cut(rest, "::")
+		if !ok {
+			return false
+		}
+		switch op {
+		case "open", "status", "bind_ipv4", "connect_ipv4", "listen", "accept", "read", "write", "close":
+			return true
